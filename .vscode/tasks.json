{
  // The apps start automatically when the devcontainer opens (runOn: folderOpen), under the show switch (ADR 0115):
  // each terminal follows its app's log. Terminal → Run Task… restarts one; killing the terminal only stops following
  // (npm run app stop [web|team|studio] stops it; http://localhost:4500/__app lists every checkout's apps).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: web (:4500)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "panel": "dedicated", "reveal": "silent", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "dev: team (:4510)",
      "type": "shell",
      "command": "npm run team",
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "panel": "dedicated", "reveal": "silent", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "dev: studio (:4520)",
      "detail": "Sanity Studio for the Cougars Dev project (docs/adr/0010-environments-and-deploys.md). Not started automatically.",
      "type": "shell",
      "command": "npm run studio",
      "isBackground": true,
      "presentation": { "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      // Phone sessions (claude.ai/code) run in the container: Remote Control starts when VS Code opens the folder, in
      // its own terminal tab; closing the tab stops it. Waits for post-start.sh's `claude` launcher.
      "label": "Claude Remote Control",
      "type": "shell",
      "command": "until [ -x \"$HOME/.local/bin/claude\" ]; do sleep 2; done; exec \"$HOME/.local/bin/claude\" remote-control --name cougars-container",
      "options": { "cwd": "/src" },
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "panel": "dedicated", "reveal": "silent", "close": false },
      "problemMatcher": []
    }
  ]
}
