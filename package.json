{
  "name": "cougars",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/web",
    "apps/studio",
    "apps/team",
    "packages/shared"
  ],
  "scripts": {
    "app": "node scripts/app.mjs",
    "dev": "node scripts/app.mjs dev web",
    "build": "npm run build -w @cougars/web",
    "studio": "node scripts/app.mjs dev studio",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:rebuild:local": "node scripts/db-rebuild.mjs --local",
    "db:migrate:local": "node scripts/db-migrate.mjs --local",
    "db:seed:local": "node scripts/seed-roster.mjs --local --anonymous",
    "seed:history": "node scripts/seed-history.mjs",
    "env:pull": "node scripts/env-pull.mjs",
    "secret:set": "node scripts/secret-set.mjs",
    "secrets": "node scripts/env-pull.mjs --status",
    "secrets:scan": "node scripts/secrets-scan.mjs",
    "admin:break-glass": "node scripts/admin-break-glass.mjs",
    "team": "node scripts/app.mjs dev team",
    "worktree": "node scripts/worktree.mjs",
    "merge:check": "node scripts/merge-check.mjs",
    "load": "node scripts/load/load.mjs",
    "journeys": "node apps/team/journeys/journeys.mjs",
    "sizes": "node scripts/sizes.mjs",
    "knip": "knip"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sentry/cli": "^3.8.0",
    "@types/better-sqlite3": "^9.6.0",
    "@vitest/coverage-v8": "^5.0.3",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "@sentry/cli": false
  }
}
