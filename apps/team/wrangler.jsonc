{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The team app (ADR 0022). main deploys it to dev and release to production, as `team` (ADR 0010,
  // scripts/ci/target.mjs). On the local dev server TEAM_ENV is "local" (vite.config.ts) and you're the first admin.
  "name": "cougars-team",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/.well-known/*"] },
  "observability": { "enabled": true },
  // The website's database: one club, one D1 (ADR 0022). Same entry as apps/web/wrangler.jsonc, so local dev
  // shares its state.
  "d1_databases": [{ "binding": "DB", "database_name": "cougars" }],
  // This deploy's id, part of the bootstrap's ETag (worker/api/api.version.ts, ADR 0053). Free; no storage.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // The live hub (ADR 0072): one object holding every live page's stream; it stores nothing. Declared SQLite-backed
  // because that is what the free plan allows; the migration makes the class on the first deploy.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }],
  // Hourly: the usage check emails the admins once a day if the free allowance passes 80% (ADR 0059). Every five
  // minutes: a wanted website rebuild, once it's quiet (worker/website/website.ts, ADR 0100). Every minute between
  // those: the push drain alone, so what quiet hours or the debounce held goes on time (ADR 0108). All free (cron
  // triggers: 5 per account; the website has 1).
  "triggers": { "crons": ["7 * * * *", "*/5 * * * *", "* * * * *"] },
  "vars": {
    // The club's GitHub App, which asks for website rebuilds (README#github_app_private_key). Not secret; its key is.
    "GITHUB_APP_CLIENT_ID": "Iv23liuUhxYcTesso0TW",
    "GITHUB_APP_INSTALLATION_ID": "169599165",
    // Web Push's public key (README#web-push, scripts/webpush-setup.mjs), for the Worker's signature and the app's
    // subscriptions (vite.config.ts builds it in). Not secret; VAPID_PRIVATE_KEY is.
    "VAPID_PUBLIC_KEY": "BAbNPSsLBAU6J1q8lELDWYGUBw289EtNIThpgCI5TV1vQ1b5AE3Q_EX9zPnInSgf1NfEOIjHQbIEewYECJFP78M",
  },
}
