{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cougars",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Astro's handler plus the daily enquiry clean-up (src/worker.ts)
  "main": "./src/worker.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Daily, 03:17 UTC: delete enquiries past 12 months (ADR 0029). Free (cron triggers: 5 per account).
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    // Only scripts/ci/target.mjs sets "production" (on release); anything else never emails a real person.
    "SITE_ENV": "dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cougars",
      // After launch, the database's migrations (ADR 0050); until then db/schema.sql
      "migrations_dir": "../../db/migrations",
    },
  ],
}
