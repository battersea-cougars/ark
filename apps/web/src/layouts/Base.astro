---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { PUBLIC_BUILD_VERSION } from "astro:env/client";
import { demo, devSanity, getSettings } from "../lib/sanity/content";
import { jsonLd } from "../lib/structured-data";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
// Ready-sized files used as they are: server-rendered pages (/photos, ADR 0016) can't resize at build time.
import carbonImage from "../assets/cougars_background.webp";

interface Props {
  title?: string;
  description?: string;
  /** A cover photo to share (1200×630). Without one, the page's drawn card is shared instead. */
  image?: string | null;
  /** Which drawn share card (pages/og/[...card].png.ts), e.g. "fridays" or "events/<slug>". */
  card?: string;
  /** schema.org data for search engines (lib/structured-data.ts). */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep out of search results (e.g. the thanks page). */
  noindex?: boolean;
}

const site = "Battersea Cougars";
const s = await getSettings();
const {
  title,
  description = `Roller hockey club in Battersea, South West London, since ${s.founded}. Friday nights, all levels${s.firstSessionKit ? ", spare kit to borrow for your first session" : ""}. Then the pub.`,
  image,
  card = "home",
  structuredData,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${site}` : `${site} · Inline hockey in Battersea, London`;
const og = image ?? new URL(`/og/${card}.png`, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const carbon = carbonImage.src;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <!-- Errors in our scripts reach Sentry (ADR 0111, pages/api/client-error.ts): first in the page, so it hears everything.
         Each distinct error once per page, a few at most; the server keeps only those from our own /_astro/ scripts.
         Code that catches its own error calls window.reportError?.(e) as usual: the browser hands it here too. -->
    <script is:inline>
      (() => {
        const seen = new Set();
        const send = (e) => {
          const err = e instanceof Error ? e : new Error(String(e));
          const key = err.message + err.stack;
          if (seen.has(key) || seen.size >= 5) return;
          seen.add(key);
          const body = JSON.stringify({
            name: err.name,
            message: String(err.message),
            stack: String(err.stack || ""),
            page: location.pathname,
          });
          if (!navigator.sendBeacon?.("/api/client-error", new Blob([body], { type: "application/json" })))
            fetch("/api/client-error", { method: "POST", body, keepalive: true }).catch(() => {});
        };
        addEventListener("error", (e) => send(e.error ?? e.message));
        addEventListener("unhandledrejection", (e) => send(e.reason));
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- With its cookies: behind Cloudflare Access (ADR 0010) a manifest fetched without them is sent to the login page -->
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={title ?? site} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image ? (title ?? site) : `${title ?? site}: ${site}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={`cougars ${PUBLIC_BUILD_VERSION}`} />
    {(demo || noindex) && <meta name="robots" content="noindex, nofollow" />}
    {structuredData && <script type="application/ld+json" set:html={jsonLd(structuredData)} />}
    <script is:inline>
      // Back/forward (incl. first load from history): skip entrance motion. From ark.
      try {
        const nav = performance.getEntriesByType("navigation")[0];
        if (nav && nav.type === "back_forward") document.documentElement.classList.add("navigation-restore");
      } catch {
        // Navigation Timing unavailable: animate as normal.
      }
    </script>
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-osd" preload />
    <ClientRouter fallback="swap" />
  </head>
  <body style={`--carbon:url(${carbon})`}>
    <a class="skip visually-hidden" href="#main">
      Skip to content
    </a>
    {import.meta.env.DEV && devSanity.problem && (
      <p class="dev-sanity" role="status">
        Sanity can't be read, so this page shows fallback content. {devSanity.problem}
      </p>
    )}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="scrollbar" data-scrollbar aria-hidden="true" transition:persist="scrollbar">
      <div class="scrollbar-thumb" data-scrollbar-thumb></div>
    </div>
    <script>
      import "../scripts/motion";
      import "../scripts/scrollbar";
      import "../scripts/cards";
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 300;
    padding: 0.6rem 1rem;
    background: var(--text);
    color: var(--paper);
  }
  /* Local only: the page is running on fallback content (ADR 0055) */
  .dev-sanity {
    position: relative;
    z-index: 100;
    margin: 0;
    padding: 0.5rem 1rem;
    background: #5c1a1a;
    color: #fff;
    font-size: 0.8rem;
  }
</style>
