---
// The home page is a Friday night, top to bottom: kit up, face-off, final whistle,
// and (now and then) the Kumite, underground. Then the week's news. Each section's
// data-time / data-title drives the header clock (scripts/motion.ts): the time on the Friday-night sections and the
// section's name beside it. The sections after the night have no time, and the clock fades out there.
import { getImage, Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import logo from "../assets/cougars.png";
import { getEvents, getPlayers, getResults, getSettings, getVideos, kitText, upcoming } from "../lib/sanity/content";
import { imageUrl, objectPosition } from "../lib/sanity/images";
import { clubData } from "../lib/structured-data";
import WhatsOn from "../components/WhatsOn.astro";
import Empty from "../components/Empty.astro";
import KumiteTeaser from "../components/KumiteTeaser.astro";
import PlayerCard from "../components/PlayerCard.astro";
import VideoReel from "../components/VideoReel.astro";
import ReigningChampions from "../components/ReigningChampions.astro";
import Lightbox from "../components/Lightbox.astro";
import PhotoStrip from "../components/PhotoStrip.astro";

const s = await getSettings();
const all = upcoming(await getEvents());
const kumite = all.find((e) => e.type === "kumite");
const slot = s.training[0];
const day = slot?.day ?? "Friday";
const players = (await getPlayers()).slice(0, 5);
// As of this build; VideoReel then swaps in the live ones (ADR 0016)
const videos = await getVideos();
// The Kumite's champions as of this build (ADR 0100)
const kumiteResults = (await getResults()).filter((r) => r.series?.slug === "kumite");
const years = new Date().getFullYear() - s.founded;
// Only a hero photo from the Studio; otherwise the site-wide carbon mesh shows through.
const heroBg = s.heroImage ? imageUrl(s.heroImage, 2000, 1200) : null;

// "Kit up": who we are. Page wording, not club facts, so it lives here rather than in Sanity (ADR 0014).
const headline = "Tough crowd. Soft centre.";
const about = [
  "Take a Van Damme film, put it on skates, hand everyone a stick and set it in South West London. That's " +
    "us: inline hockey at Battersea Sports Centre since 1996. Nearly 30 years on the same sport court has " +
    "made us part of the furniture of London's inline hockey scene.",
  "First-timers, league players and everyone in between, all on one rink. Nobody cares where you're from " +
    "or how well you skate. Turn up, gear up, play.",
  "Some of us play league hockey for the club in BIPHA. All of us play on Friday. And when the final " +
    "whistle goes, everyone heads to the pub.",
];

// Quick facts under "Kit up"
const strip: [string, string][] = [
  [String(s.founded), "Founded"],
  [`${years} yrs`, "Same rink"],
  ...(s.team.league ? ([[s.team.league, "League team"]] as [string, string][]) : []),
];
// The logo search engines show for the club: 512px is plenty, rather than the 1.3 MB original
const searchLogo = (await getImage({ src: logo, width: 512, format: "png" })).src;
---

<Base
  structuredData={clubData(
    s,
    Astro.site!,
    searchLogo,
    `Roller hockey club in Battersea, South West London, since ${s.founded}.`,
  )}
>
  <!-- Poster hero: the logo, and the one line that matters -->
  <section
    class="hero"
    id="top"
    style={heroBg ? `--hero-bg:url(${heroBg});--hero-pos:${objectPosition(s.heroImage)}` : undefined}
  >
    <h1 class="visually-hidden">Battersea Cougars inline hockey club</h1>
    <Image class="hero-logo" src={logo} alt="Battersea Cougars" width={720} loading="eager" fetchpriority="high" />
    <p class="hero-line">
      Roller hockey club <span>·</span> South West London <span>·</span> Since {s.founded}
    </p>
    <div class="hero-actions">
      <a class="btn btn--primary" href="/join/">
        Try a session
      </a>
      {slot && (
        <a
          class="hero-when"
          href="#fridays"
          data-countdown
          data-day={slot.day}
          data-start={slot.start}
          data-end={slot.end}
        >
          <span data-countdown-text>
            {day}s {slot.start}
          </span>
        </a>
      )}
    </div>
  </section>

  <!-- 19:00 Kit up: who we are -->
  <section class="section wrap club" id="club" data-time="19:00" data-title="Kit up">
    <div class="club-head" data-reveal>
      <p class="stamp">19:00</p>
      <p class="kicker">Kit up · Who we are</p>
      <h2>{headline}</h2>
    </div>
    <div class="club-body" data-reveal style="--i:1">
      {about.map((para) => (
        <p class="lede">{para}</p>
      ))}
    </div>
    <dl class="strip">
      {strip.map(([value, label], i) => (
        <div data-reveal style={`--i:${i}`}>
          <dt class="label">{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- The club ethos -->
  <aside class="notice" aria-label="Club ethos" data-reveal>
    <div class="wrap notice-inner">
      <p class="kicker">House rule</p>
      <p class="notice-text">
        Hooking, slashing or refusing to pass may result in being <em>drafted first.</em>
      </p>
    </div>
  </aside>

  <!-- 19:30 Face-off: Friday hockey -->
  <section class="section band" id="fridays" data-time={slot?.start ?? "19:30"} data-title="Face-off">
    <div class="wrap fridays">
      <div class="fridays-head" data-reveal>
        <p class="stamp">{slot?.start ?? "19:30"}</p>
        <p class="kicker">Face-off · Every {day}</p>
        <h2>{day} night hockey</h2>
        {slot && (
          <p class="time num">
            {slot.start}
            <span class="dash">–</span>
            {slot.end}
          </p>
        )}
        <p class="lede">{slot?.description}</p>
      </div>
      <div class="fridays-copy" data-reveal style="--i:1">
        <dl class="facts">
          <div>
            <dt class="label">Where</dt>
            <dd>
              <a class="link strong" href={s.venue.mapUrl} rel="noopener" target="_blank">
                {s.venue.name} ↗
              </a>
              <span class="muted">{s.venue.address}</span>
            </dd>
          </div>
          <div>
            <dt class="label">Bring</dt>
            <dd>
              <span class="strong">Helmet, gloves, shins</span>
              <span class="muted">{kitText(s)}</span>
            </dd>
          </div>
          <div>
            <dt class="label">Who</dt>
            <dd>
              <span class="strong">Anyone who skates</span>
              <span class="muted">
                Never played hockey, or played for years. Same rink, balanced teams. Non-contact, not no-contact.
              </span>
            </dd>
          </div>
        </dl>
        <div class="actions">
          <a class="btn btn--primary" href="/join/">
            Try a session
          </a>
          <a class="more" href="/fridays/">
            Your first {day}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 21:30 Final whistle: the characters, while the team is on the website (ADR 0109) -->
  {s.team.onWebsite && (
    <section class="section team" id="team" data-time={slot?.end ?? "21:30"} data-title="Final whistle">
      <div class="wrap section-head" data-reveal>
        <div>
          <p class="stamp">{slot?.end ?? "21:30"}</p>
          <p class="kicker">Final whistle · The team{s.team.league && ` · ${s.team.league}`}</p>
          <h2>Some characters</h2>
          <p class="lede">{s.team.intro}</p>
        </div>
        <a class="more" href="/team/">
          Full roster
        </a>
      </div>
      {players.length > 0 ? (
        <ul class="hand">
          {players.map((p, i) => (
            <li data-reveal style={`--i:${i};--tilt:${[-4, 2.5, -1.5, 3.5, -3][i % 5]}deg`}>
              <PlayerCard player={p} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="wrap">
          <Empty>
            Roster coming soon. <a href="/team/">See the team page</a>.
          </Empty>
        </div>
      )}
    </section>
  )}

  <!-- Off the record: the Kumite, underground, while it's on the website (ADR 0109) -->
  {s.kumite.onWebsite && (
    <section class="night kumite" id="kumite" data-time="--:--" data-title="Off the record" data-night>
      <!-- A teaser here; the full poster, the rules and the awards are the Kumite page's -->
      <KumiteTeaser next={kumite} />
      {kumiteResults.length > 0 && (
        <div class="wrap section kumite-more" data-reveal>
          <ReigningChampions results={kumiteResults} />
        </div>
      )}
    </section>
  )}

  <!-- The week: what's on -->
  <section class="section wrap" id="events" data-title="What's on">
    <div class="section-head" data-reveal>
      <div>
        <p class="kicker">Coming up</p>
        <h2>On the calendar</h2>
        <p class="lede">Training, tournaments and socials, straight from the club diary.</p>
      </div>
      <a class="more" href="/events/">
        All events
      </a>
    </div>
    <div data-reveal>
      <WhatsOn items={null} day={day} />
    </div>
  </section>

  <!-- Videos: mostly Friday night sessions -->
  <section class="section band" id="videos" data-title="Videos">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">Replay</p>
          <h2>{day} nights, filmed</h2>
          <p class="lede">We set up a camera on {day} nights. Every goal, every fall, on camera.</p>
        </div>
        <a class="more" href="/videos/">
          All videos
        </a>
      </div>
      <div data-reveal>
        <VideoReel videos={videos} day={day} />
      </div>
    </div>
  </section>

  <!-- Photo gallery -->
  <section class="section wrap" id="photos" data-title="Gallery">
    <div class="section-head" data-reveal>
      <div>
        <p class="kicker">Gallery</p>
        <h2>The evidence</h2>
        <p class="lede">Photographic proof that some of us can skate.</p>
      </div>
      <a class="more" href="/photos/">
        All photos
      </a>
    </div>
    <PhotoStrip instagram={s.socials.instagram} />
  </section>
  <Lightbox />
</Base>

<style>
  /* ---------- Hero: fight-night poster ---------- */
  .hero {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: clamp(1.25rem, 3vh, 2rem);
    min-height: 100svh;
    padding: calc(var(--header-h) + 2.5rem) var(--gutter) 3rem;
    text-align: center;
    overflow: clip;
    isolation: isolate;
    /* carbon fibre, a red glow behind the logo, fading into the page */
    /* the page's carbon mesh (or the Studio's hero photo), a red glow behind the logo */
    background:
      radial-gradient(circle at 50% 42%, rgb(229 19 31 / 0.3), transparent 42%),
      radial-gradient(ellipse 75% 65% at 50% 45%, transparent, rgb(13 13 15 / 0.65)),
      var(--hero-bg, none) var(--hero-pos, center) / cover no-repeat;
  }
  .hero :global(.hero-logo) {
    width: min(78vw, 34rem, 54svh);
    height: auto;
    filter: drop-shadow(0 30px 60px rgb(0 0 0 / 0.65));
  }
  .hero-line {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .hero-line span {
    color: var(--red);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 2rem;
  }
  /* The scoreboard: the next face-off counting down (scripts/countdown.ts). Wide enough for its longest line
     ("Playing now · till 21:30"), so the ticking never moves anything. */
  .hero-when {
    display: inline-block;
    min-width: 30ch;
    font-family: var(--display);
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .hero-when:hover {
    color: var(--text);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero-logo) {
      animation: logo-in 1.2s var(--ease-smooth) 0.1s both;
    }
    .hero-line,
    .hero-actions {
      animation: logo-in 1s var(--ease-smooth) 0.45s both;
    }
    :global(html.navigation-restore) .hero :global(.hero-logo),
    :global(html.navigation-restore) .hero-line,
    :global(html.navigation-restore) .hero-actions {
      animation: none;
    }
  }
  @keyframes logo-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
  }

  /* ---------- Shared section bits ---------- */
  /* "19:30 —— FACE-OFF": time stamp and kicker on one line */
  .stamp {
    margin: 0 0.75rem 0 0;
    vertical-align: top;
  }
  .stamp + .kicker {
    height: 1.68rem; /* the stamp's height: 1.05rem type + 0.6em padding */
    margin: 0;
    vertical-align: top;
  }
  .kicker + h2 {
    margin-top: 0.9rem;
  }
  h2 + .lede {
    margin-top: 1.25rem;
  }
  /* Alternate sections sit on a darker band of paper */
  .band {
    background: rgb(255 255 255 / 0.03);
    border-block: 1px solid var(--rule);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .section-head .lede {
    margin-bottom: 0;
  }
  .strong {
    font-weight: 700;
    color: var(--text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  /* ---------- Kit up ---------- */
  .club {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 2rem clamp(3rem, 8vw, 7rem);
    align-items: end;
  }
  .club-body .lede:last-child {
    margin-bottom: 0;
  }
  .strip {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    margin: clamp(1rem, 3vw, 2rem) 0 0;
    border-top: 1px solid var(--rule-strong);
  }
  .strip div {
    padding: 1.4rem 1.5rem 0 0;
  }
  .strip div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }
  .strip dd {
    margin: 0.5rem 0 0;
    font-family: var(--display);
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .strip div:first-child dd {
    color: var(--red-hot);
  }

  /* ---------- The ethos: a warning sign ---------- */
  .notice {
    padding-block: clamp(3rem, 7vw, 5rem);
    border-block: 1px solid var(--rule);
  }
  .notice-inner {
    display: grid;
    gap: 1rem;
  }
  .notice-text {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2.2rem, 5.4vw, 4.75rem);
    line-height: 0.98;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .notice-text em {
    font-style: normal;
    color: var(--red-hot);
  }
  /* ---------- Face-off ---------- */
  .fridays {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem clamp(3rem, 7vw, 6rem);
    align-items: end;
  }
  .time {
    margin: 1rem 0 0;
    font-size: clamp(3.4rem, 8vw, 6.5rem);
    line-height: 0.9;
    color: var(--red);
  }
  .time .dash {
    color: var(--text);
    margin-inline: 0.06em;
  }
  .fridays-copy {
    display: grid;
    gap: 2rem;
  }
  .facts {
    margin: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .facts > div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.5rem 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .facts dt {
    padding-top: 0.2rem;
  }
  .facts dd {
    margin: 0;
    display: grid;
    justify-items: start;
    gap: 0.2rem;
  }

  /* ---------- Final whistle: a hand of cards, dealt crooked ---------- */
  .team {
    overflow-x: clip;
  }
  .hand {
    list-style: none;
    margin: 0;
    padding: 1rem var(--gutter) 2.5rem;
    display: flex;
    justify-content: safe center;
    gap: clamp(1rem, 2vw, 1.75rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .hand::-webkit-scrollbar {
    display: none;
  }
  .hand li {
    flex: 0 0 clamp(12rem, 15vw, 14rem);
    rotate: var(--tilt);
    scroll-snap-align: center;
    transition: rotate 0.5s var(--ease-smooth);
  }
  .hand li:hover,
  .hand li:focus-within {
    rotate: 0deg;
    z-index: 1;
  }

  /* ---------- Kumite: underground ---------- */
  .kumite-more {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  /* ---------- Small screens ---------- */
  @media (max-width: 56rem) {
    .club,
    .fridays,
    .kumite-more {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 40rem) {
    .strip div + div {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>

<script>
  import "../scripts/countdown";
</script>
