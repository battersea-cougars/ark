---
// Every club video, newest first (pinned ones on top). Rendered on the Worker at request time from YouTube and
// Sanity, both cached (ADR 0016), so a new upload or a Studio change shows within minutes, with no rebuild.
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import VideoCard from "../../components/VideoCard.astro";
import Empty from "../../components/Empty.astro";
import { getSettings } from "../../lib/sanity/content";
import { liveVideos } from "../../lib/server/videos";
import { cacheControl, videosConfig } from "../../lib/server/sanity-env";

export const prerender = false;

const { data: videos, unavailable } = await liveVideos(videosConfig());
const s = await getSettings();

Astro.response.headers.set("Cache-Control", cacheControl(unavailable));
if (unavailable) Astro.response.status = 503;
---

<Base title="Videos" card="videos" description="Footage from Friday night inline hockey in Battersea.">
  <PageHeader
    eyebrow="Footage"
    title="Videos"
    lede={`Games and highlights from Friday sessions${s.kumite.onWebsite ? " and the Kumite" : ""}.`}
  >
    {s.socials.youtube && (
      <a class="btn" href={s.socials.youtube} rel="noopener" target="_blank">
        YouTube channel ↗
      </a>
    )}
  </PageHeader>
  <div class="wrap page-body">
    {videos.length ? (
      <div class="grid videos">
        {videos.map((v, i) => (
          <div data-reveal style={`--i:${i % 2}`}>
            <VideoCard video={v} />
          </div>
        ))}
      </div>
    ) : (
      <Empty>
        {unavailable
          ? "The videos won't load right now. Try again in a minute."
          : "No videos yet. Footage from Friday sessions will appear here."}
      </Empty>
    )}
  </div>
</Base>

<style>
  .videos {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr));
  }
</style>
