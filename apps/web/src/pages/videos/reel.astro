---
// The home page's video reel, rendered live for its script to swap in (components/VideoReel.astro, ADR 0016).
// A partial: just the component's HTML, no page around it. The home page already has its styles.
import VideoReel from "../../components/VideoReel.astro";
import { getSettings } from "../../lib/sanity/content";
import { liveVideos } from "../../lib/server/videos";
import { cacheControl } from "../../lib/server/sanity-env";
import { liveVideosConfig } from "../../lib/server/videos-env";

export const prerender = false;
export const partial = true;

const { data: videos, unavailable } = await liveVideos(liveVideosConfig());
const day = (await getSettings()).training[0]?.day ?? "Friday";

Astro.response.headers.set("Cache-Control", cacheControl(unavailable));
// A piece of the home page, not a page: never in search results on its own
Astro.response.headers.set("X-Robots-Tag", "noindex");
if (unavailable) Astro.response.status = 503;
---

<VideoReel videos={videos} day={day} />
