---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import { getEventPages, getSettings } from "../../lib/sanity/content";
import { eventData } from "../../lib/structured-data";
import { imageSrcSet, imageUrl, objectPosition } from "../../lib/sanity/images";
import { renderPortableText } from "../../lib/portable-text";
import { formatRange } from "../../lib/dates";
import type { ClubEvent } from "../../lib/sanity/types";

export const getStaticPaths = (async () =>
  (await getEventPages()).map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }))) satisfies GetStaticPaths;

const { event } = Astro.props as { event: ClubEvent };
const cover = imageUrl(event.cover, 1600, 900);
const TYPE = { training: "Training", social: "Social", tournament: "Tournament", kumite: "Special event · Kumite" };
const body = renderPortableText(event.body);
const s = await getSettings();
// Back to the Kumite only while it has a page (ADR 0109)
const toKumite = event.type === "kumite" && s.kumite.onWebsite;
const url = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = imageUrl(event.cover, 1200, 630) ?? new URL(`/og/events/${event.slug}.png`, Astro.site).href;
---

<Base
  title={event.title}
  card={`events/${event.slug}`}
  description={event.summary ?? undefined}
  image={imageUrl(event.cover, 1200, 630)}
  structuredData={eventData(event, s, url, shareImage)}
>
  <article class="wrap page-body">
    <header class="head">
      <a class="label link back" href={toKumite ? "/kumite/" : "/events/"} data-reveal>
        ← {toKumite ? "Kumite" : "Events"}
      </a>
      <p class:list={["label", { accent: event.type === "kumite" }]} data-reveal style="--i:1">
        {TYPE[event.type]}
      </p>
      <h1 data-reveal style="--i:2">
        {event.title}
      </h1>
      {event.summary && (
        <p class="lede" data-reveal style="--i:3">
          {event.summary}
        </p>
      )}
    </header>

    <dl class="facts" data-reveal style="--i:4">
      <div>
        <dt class="label">When</dt>
        <dd>{formatRange(event.startsAt, event.endsAt)}</dd>
      </div>
      {event.location && (
        <div>
          <dt class="label">Where</dt>
          <dd>{event.location}</dd>
        </div>
      )}
      <div class="actions">
        {event.ctaUrl && (
          <a class="btn btn--primary" href={event.ctaUrl}>
            {event.ctaLabel ?? "Sign up"}
          </a>
        )}
        <a class="btn" href={`/events/${event.slug}.ics`}>
          Add to calendar
        </a>
      </div>
    </dl>

    {cover && (
      <img
        class="cover"
        src={cover}
        srcset={imageSrcSet(event.cover, [800, 1200, 1600], 16 / 9)}
        sizes="(max-width: 70rem) 100vw, 70rem"
        alt={event.cover?.alt ?? ""}
        style={`object-position:${objectPosition(event.cover)}`}
        data-reveal
      />
    )}
    {body && <div class="prose" set:html={body} data-reveal />}
  </article>
</Base>

<style>
  .head {
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 6rem));
    padding-bottom: 2.5rem;
  }
  .back {
    display: block;
    width: fit-content;
    margin-bottom: 3rem;
  }
  .accent {
    color: var(--red);
  }
  h1 {
    margin: 1rem 0 0;
    max-width: 20ch;
  }
  .lede {
    margin: 1.5rem 0 0;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 3.5rem;
    margin: 0 0 3rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .facts dd {
    margin: 0.35rem 0 0;
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-left: auto;
  }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 3rem;
  }
</style>
