---
// Everything coming up, live from the club calendar the team app keeps, as on the home page (ADR 0042). Past
// events with their own pages still come from Sanity until they move over.
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import EventList from "../../components/EventList.astro";
import WhatsOn from "../../components/WhatsOn.astro";
import Empty from "../../components/Empty.astro";
import { getEvents, getSettings, upcoming } from "../../lib/sanity/content";
import { ALL_LIMITS, cachedWhatsOn, type WhatsOnItem } from "../../lib/server/whats-on";
import { cacheControl } from "../../lib/server/sanity-env";
import { scribe } from "@cougars/shared/scribe";
const log = scribe.logger("events");

export const prerender = false;

let items: WhatsOnItem[] = [];
let unavailable = false;
try {
  items = await cachedWhatsOn(env.DB, ALL_LIMITS);
} catch (error) {
  log.error("events.d1_error", error);
  unavailable = true;
}
Astro.response.headers.set("Cache-Control", cacheControl(unavailable));

const all = await getEvents();
const next = upcoming(all);
const past = all
  .filter((e) => !next.includes(e))
  .reverse()
  .slice(0, 12);
const s = await getSettings();
const day = s.training[0]?.day ?? "Friday";
---

<Base
  title="Events"
  card="events"
  description={s.kumite.onWebsite ? "Tournaments, socials and the Cougars Kumite." : "Tournaments and socials."}
>
  <PageHeader
    eyebrow="What's on"
    title="Events"
    lede={`Special events on top of regular ${day} hockey: ${s.kumite.onWebsite ? "the Kumite, " : ""}tournaments and socials.`}
  />
  <div class="wrap page-body">
    {unavailable ? (
      <Empty>
        The calendar didn't load. We're on court every {day}: <a href="/fridays/">come along</a>.
      </Empty>
    ) : (
      <WhatsOn items={items} day={day} />
    )}
    {!unavailable && items.length > 0 && items.every((i) => i.kind === "training") && (
      <p class="nothing-else muted">Nothing special booked yet. {day}s are always on.</p>
    )}
    {past.length > 0 && (
      <section class="past">
        <p class="kicker" data-reveal>
          Past events
        </p>
        <EventList events={past} />
      </section>
    )}
  </div>
</Base>

<style>
  .nothing-else {
    margin: 1.5rem 0 0;
  }
  .past {
    margin-top: clamp(4rem, 9vw, 6rem);
    opacity: 0.7;
  }
  .past .label {
    margin-bottom: 1.5rem;
  }
</style>
