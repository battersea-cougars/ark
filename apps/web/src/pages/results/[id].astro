---
// One tournament's result, as of this build (ADR 0100): the champions, the awards (once confirmed), the table, every
// score (and each side's penalty minutes, ADR 0061), who scored and who played. Only a public tournament that's done has a page; the team app starts a rebuild
// when a result changes.
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { formatDate } from "../../lib/dates";
import { getResults } from "../../lib/sanity/content";
import type { PublishedEdition } from "../../lib/results";

export const getStaticPaths = (async () =>
  (await getResults()).map((r) => ({ params: { id: String(r.id) }, props: { r } }))) satisfies GetStaticPaths;

const { r } = Astro.props as { r: PublishedEdition };
const groups = r.games.filter((g) => g.stage === "group");
// The playoffs first: the final is what people come for
const rounds = [
  { title: "Playoffs", games: r.games.filter((g) => g.stage === "playoff") },
  { title: "Games", games: groups },
];
const awards = r.awards.filter((a) => a.winners.length);
// Penalty minutes show only where there were any
const anyPim = r.scorers.some((s) => s.pim > 0) || r.games.some((g) => g.homePim + g.awayPim > 0);
---

<Base
  title={`${r.name}, ${r.season}`}
  card="kumite"
  description={`${r.name}, ${r.season}: ${r.champions ? `${r.champions} are the champions.` : "the results."}`}
>
  <PageHeader
    eyebrow={`${r.season}${r.series ? ` · ${r.series.name}` : ""}`}
    title={r.name}
    lede={formatDate(r.heldOn)}
  />
  <div class="wrap page-body">
    <section class="champions" data-reveal>
      <p class="kicker">Champions</p>
      <p class="team">
        {r.championsCrest && <img src={r.championsCrest} alt="" width="64" height="64" />}
        {r.champions ?? "Not decided"}
      </p>
    </section>

    {awards.length > 0 && (
      <section class="block" data-reveal>
        <p class="kicker">Awards</p>
        <ul class="awards">
          {awards.map((a) => (
            <li>
              <span class="award">
                <strong>{a.name}</strong>
                {a.about && <span class="muted">{a.about}</span>}
              </span>
              <span class="winner">{a.winners.join(", ")}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {r.table.length > 0 && groups.length > 0 && (
      <section class="block" data-reveal>
        <p class="kicker">The table</p>
        <div class="table-scroll">
          <table class="grid">
            <thead>
              <tr>
                <th class="label" scope="col">
                  Team
                </th>
                {["P", "W", "D", "L", "GF", "GA", "Pts"].map((h) => (
                  <th class="label num" scope="col">
                    {h}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {r.table.map((t) => (
                <tr>
                  <th scope="row">{t.name}</th>
                  <td class="num">{t.p}</td>
                  <td class="num">{t.w}</td>
                  <td class="num">{t.d}</td>
                  <td class="num">{t.l}</td>
                  <td class="num">{t.gf}</td>
                  <td class="num">{t.ga}</td>
                  <td class="num">
                    <strong>{t.pts}</strong>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {rounds.map(
      (round) =>
        round.games.length > 0 && (
          <section class="block" data-reveal>
            <p class="kicker">{round.title}</p>
            <ol class="games">
              {round.games.map((g) => (
                <li>
                  {g.name && <span class="label">{g.name}</span>}
                  <span class={g.homeGoals > g.awayGoals ? "side won" : "side"}>{g.home}</span>
                  <span class="score">
                    {g.homeGoals}–{g.awayGoals}
                  </span>
                  <span class={g.awayGoals > g.homeGoals ? "side away won" : "side away"}>{g.away}</span>
                  {g.homePim + g.awayPim > 0 && (
                    <span class="pim muted">
                      PIM {g.homePim}–{g.awayPim}
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ),
    )}

    {r.scorers.length > 0 && (
      <section class="block" data-reveal>
        <p class="kicker">{anyPim ? "Players" : "Scorers"}</p>
        <div class="table-scroll">
          <table class="grid">
            <thead>
              <tr>
                <th class="label" scope="col">
                  Player
                </th>
                <th class="label" scope="col">
                  Team
                </th>
                <th class="label num" scope="col">
                  Goals
                </th>
                <th class="label num" scope="col">
                  Assists
                </th>
                {anyPim && (
                  <th class="label num" scope="col">
                    <abbr title="Penalty minutes">PIM</abbr>
                  </th>
                )}
              </tr>
            </thead>
            <tbody>
              {r.scorers.map((s) => (
                <tr>
                  <th scope="row">{s.name}</th>
                  <td>{s.team}</td>
                  <td class="num">{s.goals}</td>
                  <td class="num">{s.assists}</td>
                  {anyPim && <td class="num">{s.pim}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="block" data-reveal>
      <p class="kicker">The teams</p>
      <ul class="teams">
        {r.teams.map((t) => (
          <li>
            <p class="team-name">
              {t.crest && <img src={t.crest} alt="" width="32" height="32" loading="lazy" />}
              {t.name}
            </p>
            <p class="muted">{t.players.join(", ")}</p>
          </li>
        ))}
      </ul>
    </section>

    <p class="back">
      <a class="more" href="/results/">
        All results
      </a>
    </p>
  </div>
</Base>

<style>
  .champions .team {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.75rem 0 0;
    font-family: var(--display);
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .champions img {
    width: 1em;
    height: 1em;
    object-fit: contain;
  }
  .block {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .awards,
  .games,
  .teams {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .awards li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .award {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .winner {
    font-family: var(--display);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    text-transform: uppercase;
  }
  .table-scroll {
    overflow-x: auto;
    margin-top: 1.25rem;
  }
  .grid {
    width: 100%;
    border-collapse: collapse;
  }
  /* .label makes headers inline-blocks; a header cell has to stay a table cell */
  .grid thead th {
    display: table-cell;
    padding: 0 1rem 0.9rem 0;
    text-align: left;
    white-space: nowrap;
    border-bottom: 1px solid var(--rule-strong);
  }
  .grid tbody th,
  .grid td {
    padding: 0.85rem 1rem 0.85rem 0;
    text-align: left;
    font-weight: inherit;
    border-bottom: 1px solid var(--rule);
    color: var(--text-2);
  }
  .grid thead th.num,
  .grid tbody td.num {
    padding-right: 0;
    padding-left: 1rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .grid strong {
    color: var(--text);
  }
  .games li {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--text-2);
  }
  .games .label {
    grid-column: 1 / -1;
    color: var(--red-hot);
  }
  .games .away {
    text-align: right;
  }
  .games .won {
    color: var(--text);
    font-weight: 600;
  }
  /* Each side's penalty minutes, under the score */
  .games .pim {
    grid-column: 2;
    justify-self: center;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .score {
    font-family: var(--display);
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  .teams li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .teams p {
    margin: 0;
  }
  .team-name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.3rem !important;
    font-weight: 600;
  }
  .team-name img {
    width: 1.6em;
    height: 1.6em;
    object-fit: contain;
  }
  .back {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
</style>
