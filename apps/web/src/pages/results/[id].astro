---
// One tournament's result, as of this build (ADR 0100), laid out as the team app shows a past one (its
// lib/EditionResults): the champions, the final, the fight card, the board, the leaders, the awards; a Kumite's in its
// motif (kanji by the titles, the champions' seal) and underground. Then who played, which only the website lists.
// Only a public tournament that's done has a page; the team app starts a rebuild when a result changes.
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Awards from "../../components/results/Awards.astro";
import BoardTable from "../../components/results/BoardTable.astro";
import ChampionCard from "../../components/results/ChampionCard.astro";
import FixtureRow from "../../components/results/FixtureRow.astro";
import Kanji from "../../components/results/Kanji.astro";
import Leaders from "../../components/results/Leaders.astro";
import TeamCrest from "../../components/results/TeamCrest.astro";
import { kanjiFace, kanjiFor } from "../../components/results/motif";
import { formatDate } from "../../lib/dates";
import { getResults } from "../../lib/sanity/content";
import type { PublishedEdition } from "../../lib/results";

export const getStaticPaths = (async () =>
  (await getResults()).map((r) => ({ params: { id: String(r.id) }, props: { r } }))) satisfies GetStaticPaths;

const { r } = Astro.props as { r: PublishedEdition };
const kumite = r.series?.slug === "kumite";
const hasBoard = r.table.length > 0 && r.games.some((g) => g.stage === "group");
const hasAwards = r.awards.some((a) => a.winners.length);
---

<Base
  title={`${r.name}, ${r.season}`}
  card="kumite"
  description={`${r.name}, ${r.season}: ${r.champions ? `${r.champions} are the champions.` : "the results."}`}
>
  {kumite && <style is:inline set:html={kanjiFace} />}
  <div class:list={{ night: kumite }} data-night-page={kumite ? "" : undefined}>
    <PageHeader
      eyebrow={`${r.season}${r.series ? ` · ${r.series.name}` : ""}`}
      title={r.name}
      lede={formatDate(r.heldOn)}
    />
    <div class="wrap page-body results">
      <ChampionCard r={r} />

      {r.final && (
        <section class="part" data-reveal>
          <h2 class="section-title">
            The final
            <Kanji text={kanjiFor(r.series, "final")} />
          </h2>
          <div class="list">
            <FixtureRow r={r} game={r.final} big />
          </div>
        </section>
      )}

      {r.games.length > 0 && (
        <section class="part" data-reveal>
          <h2 class="section-title">
            Fight card
            <Kanji text={kanjiFor(r.series, "fights")} />
          </h2>
          <div class="list">
            {r.games.map((g) => (
              <FixtureRow r={r} game={g} />
            ))}
          </div>
        </section>
      )}

      {hasBoard && (
        <section class="part" data-reveal>
          <h2 class="section-title">The board</h2>
          <div class="list">
            <BoardTable r={r} />
          </div>
        </section>
      )}

      {r.leaders.length > 0 && (
        <section class="part" data-reveal>
          <h2 class="section-title">Leaders</h2>
          <div class="list">
            <Leaders r={r} />
          </div>
        </section>
      )}

      {hasAwards && (
        <section class="part" data-reveal>
          <h2 class="section-title">
            Awards
            <Kanji text={kanjiFor(r.series, "awards")} />
          </h2>
          <Awards r={r} />
        </section>
      )}

      <section class="part" data-reveal>
        <h2 class="section-title">The teams</h2>
        <ul class="teams">
          {r.teams.map((t) => (
            <li>
              <TeamCrest team={t} size="2rem" />
              <span class="who">
                <span class="team-name">{t.name}</span>
                <span class="muted">{t.players.join(", ")}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>

      <p class="back">
        <a class="more" href="/results/">
          All results
        </a>
      </p>
    </div>
  </div>
</Base>

<style>
  /* One column of parts, space between them rather than lines, as the team app's */
  .results {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  .part {
    display: grid;
    gap: 0.75rem;
  }
  /* The team app's section title: the display face, italic capitals, red but not shouting; the kanji beside it */
  .section-title {
    margin: 0;
    color: color-mix(in srgb, var(--red-hot) 62%, var(--text-3));
    font-size: 1.6rem;
    font-style: italic;
    letter-spacing: 0.02em;
    line-height: 1.1;
    text-transform: uppercase;
  }
  /* Glass, as the team app's lists: a breath of light over the page, no edge */
  .list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    background: rgb(236 232 225 / 0.03);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .list > :global(* + *) {
    border-top: 1px solid var(--rule);
  }
  .teams {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .teams li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .who {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .team-name {
    font-weight: 600;
  }
  .back {
    margin: 0;
  }
</style>
