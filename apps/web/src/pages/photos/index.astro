---
// The club's photos: its newest Instagram posts (ADR 0113), so admins post there and the site follows within ten
// minutes. Rendered on the Worker at request time. Each opens in the lightbox, with a link to the post; a video plays
// on Instagram. Without JavaScript a tile opens the picture itself.
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Empty from "../../components/Empty.astro";
import Lightbox from "../../components/Lightbox.astro";
import { getSettings } from "../../lib/sanity/content";
import { latestPosts } from "../../lib/server/instagram";
import { instagramConfig } from "../../lib/server/instagram-env";
import { cacheControl } from "../../lib/server/sanity-env";
import { postLabel, postMark } from "../../lib/posts";

export const prerender = false;

const { data: posts, unavailable } = await latestPosts(instagramConfig());
const s = await getSettings();
const day = s.training[0]?.day ?? "Friday";
const instagram = s.socials.instagram;

Astro.response.headers.set("Cache-Control", cacheControl(unavailable));
if (unavailable) Astro.response.status = 503;
---

<Base
  title="Gallery"
  card="photos"
  description={`Photos from Cougars ${day} nights${s.kumite.onWebsite ? ", the Kumite" : ""} and the rest, from the club's Instagram.`}
>
  <PageHeader
    eyebrow="Gallery"
    title="The evidence"
    lede={`Photographic proof that some of us can skate. ${day} nights${s.kumite.onWebsite ? ", Kumite days" : ""} and the rest, straight from the club's Instagram.`}
  />
  <div class="wrap page-body">
    {posts.length ? (
      <>
        <ul class="grid" data-gallery>
          {posts.map((p, i) => (
            <li data-reveal style={`--i:${i % 3}`}>
              <a
                href={p.image}
                data-photo
                data-caption={p.caption ?? ""}
                data-post={p.href}
                data-post-label={postLabel(p)}
              >
                <img src={p.image} alt={p.alt} width="540" height="540" loading={i < 6 ? "eager" : "lazy"} />
                {postMark(p) && (
                  <span class="mark label" aria-label={p.kind === "video" ? "Video" : `${p.count} photos`}>
                    {postMark(p)}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
        {instagram && (
          <p class="more">
            <a class="btn" href={instagram} rel="noopener" target="_blank">
              More on Instagram
            </a>
          </p>
        )}
      </>
    ) : (
      <Empty>
        {unavailable
          ? "The photos won't load right now. Try again in a minute, or see them on "
          : "No photos yet. See "}
        <a href={instagram ?? "#"} rel="noopener" target="_blank">
          Instagram
        </a>
        .
      </Empty>
    )}
  </div>
  <Lightbox />
</Base>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 15rem), 1fr));
    gap: 0.5rem;
  }
  .grid a {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--rule);
  }
  .grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition:
      transform 0.6s var(--ease-out),
      filter 0.4s;
  }
  .grid a:hover img {
    transform: scale(1.05);
    filter: none;
  }
  .mark {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.2rem 0.45rem;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
  }
  .more {
    margin: 2.5rem 0 0;
    text-align: center;
  }
</style>
