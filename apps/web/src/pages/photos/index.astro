---
// Every album, newest first: a cover each, linking to the album's own page. Rendered on the Worker from
// Sanity at request time (ADR 0016), so a published album is here within minutes, with no rebuild.
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Empty from "../../components/Empty.astro";
import { getSettings } from "../../lib/sanity/content";
import { imageSrcSet, imageUrl } from "../../lib/sanity/images";
import { formatDate } from "../../lib/dates";
import { listAlbums } from "../../lib/server/photos";
import { cacheControl, photosConfig } from "../../lib/server/sanity-env";

export const prerender = false;

const { data: albums, unavailable } = await listAlbums(photosConfig());
const s = await getSettings();
const day = s.training[0]?.day ?? "Friday";
const plural = (n: number) => `${n} photo${n === 1 ? "" : "s"}`;

Astro.response.headers.set("Cache-Control", cacheControl(unavailable));
if (unavailable) Astro.response.status = 503;
---

<Base
  title="Photos"
  card="photos"
  description={`Photos from Cougars ${day} nights${s.kumite.onWebsite ? ", the Kumite" : ""} and the rest.`}
>
  <PageHeader
    eyebrow="Photos"
    title="The evidence"
    lede={`Photographic proof that some of us can skate. ${day} nights${s.kumite.onWebsite ? ", Kumite days" : ""} and the rest; pick a tape.`}
  />
  <div class="wrap page-body">
    {albums.length ? (
      <ul class="albums">
        {albums.map((a, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <a href={`/photos/${a.slug}/`}>
              <span class="cover">
                {a.cover && (
                  <img
                    src={imageUrl(a.cover, 600, 450)}
                    srcset={imageSrcSet(a.cover, [400, 600, 900], 4 / 3)}
                    sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 24rem"
                    alt={a.cover.alt ?? ""}
                    width="600"
                    height="450"
                    loading={i < 3 ? "eager" : "lazy"}
                  />
                )}
              </span>
              <div class="meta">
                <h2>{a.title}</h2>
                <p class="label">
                  {a.date && formatDate(a.date)} · {plural(a.photoCount)}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <Empty>
        {unavailable
          ? "The photos won't load right now. Try again in a minute, or see more on "
          : "No photos yet. See more on "}
        <a href={s.socials.instagram ?? "#"} rel="noopener" target="_blank">
          Instagram
        </a>
        .
      </Empty>
    )}
  </div>
</Base>

<style>
  .albums {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 2.5rem 1.25rem;
  }
  .albums a {
    display: grid;
    gap: 0.75rem;
  }
  .cover {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--rule);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition:
      transform 0.6s var(--ease-out),
      filter 0.4s;
  }
  .albums a:hover img {
    transform: scale(1.05);
    filter: none;
  }
  .meta {
    display: grid;
    gap: 0.35rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .meta h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    line-height: 1.05;
  }
  .meta .label {
    margin: 0;
  }
  .albums a:hover h2 {
    color: var(--red-hot);
  }
</style>
