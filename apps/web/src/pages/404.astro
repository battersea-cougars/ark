---
// Not found: two minutes in the penalty box. The scoreboard counts the penalty down once (not with reduced motion);
// served, it says so and the way home gets a nudge. Nothing happens by itself: no redirect.
import Base from "../layouts/Base.astro";
import { getSections } from "../lib/sanity/content";

const sections = await getSections();
---

<Base title="Page not found" noindex>
  <section class="box">
    <div class="copy">
      <p class="kicker">404 · Penalty</p>
      <h1>Two minutes for getting lost.</h1>
      <p class="lede">This page doesn't exist, or it's been sent off. Serve your time, then get back out there.</p>
      <p class="links">
        <a class="btn btn--primary" href="/" data-penalty-home>
          Back to home
        </a>
        <a class="label link" href="/fridays/">
          Fridays
        </a>
        {sections.kumite && (
          <a class="label link" href="/kumite/">
            Kumite
          </a>
        )}
        <a class="label link" href="/events/">
          What's on
        </a>
      </p>
    </div>
    <div class="board" aria-hidden="true">
      <p class="board-label">Penalty</p>
      <p class="board-clock" data-penalty-clock>
        2:00
      </p>
      <p class="board-label">Getting lost</p>
    </div>
  </section>
</Base>

<style>
  .box {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 3rem;
    min-height: 100svh;
    padding: calc(var(--header-h) + 2.5rem) var(--gutter) 4rem;
    max-width: 78rem;
    margin-inline: auto;
  }
  h1 {
    margin: 0.75rem 0 1.25rem;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.92;
    text-transform: uppercase;
  }
  .lede {
    max-width: 32rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }
  /* The rink's scoreboard: red digits behind dark glass */
  .board {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 2rem 2.5rem;
    border: 1px solid var(--rule-strong);
    background: rgb(0 0 0 / 0.55);
    box-shadow: inset 0 0 40px rgb(0 0 0 / 0.6);
    font-family: var(--display);
    text-transform: uppercase;
  }
  .board p {
    margin: 0;
  }
  .board-label {
    font-size: 1rem;
    letter-spacing: 0.15em;
    color: var(--text-2);
  }
  .board-clock {
    min-width: 6ch;
    text-align: center;
    font-size: clamp(5rem, 12vw, 9rem);
    line-height: 1;
    color: var(--red-hot);
    text-shadow: 0 0 18px rgb(244 64 74 / 0.55);
    font-variant-numeric: tabular-nums;
  }
  /* Served: the way home asks to be pressed */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-penalty-home].served) {
      animation: nudge 0.6s var(--ease-out) 2;
    }
  }
  @keyframes nudge {
    50% {
      translate: 0 -5px;
    }
  }
  @media (max-width: 52rem) {
    .box {
      grid-template-columns: 1fr;
      align-content: center;
    }
    .board {
      justify-self: start;
      padding: 1.25rem 1.75rem;
    }
  }
</style>

<script>
  // Two minutes, once. Fixed width (6ch, room for "SERVED"), so the clock changing never moves anything.
  function start() {
    const clock = document.querySelector<HTMLElement>("[data-penalty-clock]");
    if (!clock || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const ends = Date.now() + 120_000;
    const tick = () => {
      if (!clock.isConnected) return;
      const left = Math.max(0, Math.ceil((ends - Date.now()) / 1000));
      clock.textContent = left ? `${Math.floor(left / 60)}:${String(left % 60).padStart(2, "0")}` : "Served";
      if (left) setTimeout(tick, 250);
      else document.querySelector("[data-penalty-home]")?.classList.add("served");
    };
    tick();
  }
  document.addEventListener("astro:page-load", start);
</script>
