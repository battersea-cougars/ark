---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PlayerCard from "../../components/PlayerCard.astro";
import Empty from "../../components/Empty.astro";
import { getPlayers, getSections, getSettings } from "../../lib/sanity/content";
import { imageSrcSet, imageUrl, objectPosition } from "../../lib/sanity/images";

// /team/ only (`page` is undefined), and only while the team is switched on in the Studio: off, the page isn't built
// at all, so the address is a 404 and out of the sitemap (ADR 0109).
export const getStaticPaths = (async () =>
  (await getSections()).team ? [{ params: { page: undefined } }] : []) satisfies GetStaticPaths;

const s = await getSettings();
const players = await getPlayers();
const photo = imageUrl(s.team.photo, 1600, 900);
// The table under the cards: the club's record for each Cougar, most sessions this year first
const roster = [...players].sort(
  (a, b) => (b.stats?.season ?? 0) - (a.stats?.season ?? 0) || (a.number ?? 999) - (b.number ?? 999),
);
const withStats = roster.some((p) => p.stats);
const year = new Date().getFullYear();
---

<Base title="Team" card="team" description="The official Battersea Cougars team: roster and player cards.">
  <PageHeader eyebrow="The official team" title="Battersea Cougars" lede={s.team.intro} />

  <div class="wrap page-body">
    <figure class="team-photo" data-reveal>
      {photo ? (
        <img
          src={photo}
          srcset={imageSrcSet(s.team.photo, [800, 1200, 1600, 2200], 16 / 9)}
          sizes="(max-width: 70rem) 100vw, 70rem"
          alt={s.team.photo?.alt ?? "The Battersea Cougars team"}
          style={`object-position:${objectPosition(s.team.photo)}`}
        />
      ) : (
        <div class="placeholder">
          <span class="label">Team photo coming soon</span>
        </div>
      )}
    </figure>

    {players.length > 0 && (
      <section class="block">
        <div class="cards-head" data-reveal>
          <p class="kicker">Collect them all</p>
          <p class="muted">Press a card to pick it up.</p>
        </div>
        <ul class="cards">
          {players.map((p, i) => (
            <li data-reveal style={`--i:${i % 4}`}>
              <PlayerCard player={p} />
            </li>
          ))}
        </ul>
      </section>
    )}
    <section class="block">
      <p class="kicker" data-reveal>
        Player stats
      </p>
      {roster.length ? (
        <div class="table-scroll" data-reveal>
          <table class="roster">
            <thead>
              <tr>
                <th class="label" scope="col">
                  Player
                </th>
                <th class="label" scope="col">
                  Position
                </th>
                {withStats && (
                  <>
                    <th class="label stat" scope="col">
                      Sessions {year}
                    </th>
                    <th class="label stat" scope="col">
                      Sessions, all time
                    </th>
                    <th class="label stat" scope="col">
                      Tournaments
                    </th>
                    <th class="label stat" scope="col">
                      Goals
                    </th>
                    <th class="label stat" scope="col">
                      Assists
                    </th>
                    <th class="label stat" scope="col">
                      Titles
                    </th>
                  </>
                )}
              </tr>
            </thead>
            <tbody>
              {roster.map((p) => (
                <tr>
                  <th scope="row">
                    <strong>{p.name}</strong>
                    {p.nickname && <span class="muted"> “{p.nickname}”</span>}
                  </th>
                  <td>{p.position ?? "–"}</td>
                  {withStats && (
                    <>
                      <td class="stat">{p.stats?.season ?? "–"}</td>
                      <td class="stat">{p.stats?.sessions ?? "–"}</td>
                      <td class="stat">{p.stats?.tournaments ?? "–"}</td>
                      <td class="stat">{p.stats?.goals ?? "–"}</td>
                      <td class="stat">{p.stats?.assists ?? "–"}</td>
                      <td class="stat">{p.stats?.titles ?? "–"}</td>
                    </>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <Empty>The roster is on its way.</Empty>
      )}
    </section>
  </div>
</Base>

<style>
  .team-photo {
    margin: 0;
  }
  .team-photo img,
  .placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-items: center;
    border: 1px dashed var(--rule-strong);
    background: radial-gradient(circle at 50% 50%, rgb(229 19 31 / 0.12), transparent 60%), var(--paper-2);
  }
  .block {
    margin-top: clamp(4rem, 9vw, 6rem);
  }
  .block > .kicker {
    margin-bottom: 1.5rem;
  }
  .roster {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .table-scroll {
    overflow-x: auto;
  }
  /* .label makes headers inline-blocks; a header cell has to stay a table cell */
  .roster thead th {
    display: table-cell;
    padding: 0 1rem 0.9rem 0;
    text-align: left;
    white-space: nowrap;
    border-bottom: 1px solid var(--rule-strong);
  }
  .roster tbody th,
  .roster td {
    padding: 1rem 1rem 1rem 0;
    text-align: left;
    font-weight: inherit;
    border-bottom: 1px solid var(--rule);
    color: var(--text-2);
  }
  /* As specific as the header and cell rules above (Astro scopes every part of a selector), so it wins */
  .roster thead th.stat,
  .roster tbody td.stat {
    padding-right: 0;
    padding-left: 1rem;
    text-align: right;
  }
  .roster strong {
    color: var(--text);
    font-weight: 600;
  }
  .cards-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .cards-head p {
    margin: 0;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (max-width: 40rem) {
    .roster th:nth-child(4),
    .roster td:nth-child(4),
    .roster th:nth-child(5),
    .roster td:nth-child(5),
    .roster th:nth-child(7),
    .roster td:nth-child(7) {
      display: none;
    }
  }
</style>
