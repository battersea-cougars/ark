---
// The home page's latest photos: the club's newest Instagram posts (ADR 0016). The page is prerendered, and its build
// can't read Instagram, so it holds twelve empty tiles in place and its script fills them from /api/photos/latest;
// nothing moves when they arrive. Without JavaScript, or with no posts, the tiles give way to a line pointing at
// Instagram. The Lightbox listens with a delegated handler, so the filled-in photos open in it.
import Empty from "./Empty.astro";

interface Props {
  instagram?: string | null;
}
const { instagram } = Astro.props;
---

<div class="strip" data-photo-strip>
  <ul class="gallery" data-gallery aria-busy="true">
    {Array.from({ length: 12 }, () => (
      <li class="placeholder" aria-hidden="true" />
    ))}
  </ul>
  <noscript>
    <Empty>
      See the photos on{" "}
      <a href={instagram ?? "/photos/"} rel="noopener" target="_blank">
        Instagram
      </a>
      .
    </Empty>
  </noscript>
  <template data-empty>
    <Empty>
      No photos yet. Meanwhile, there's{" "}
      <a href={instagram ?? "/photos/"} rel="noopener" target="_blank">
        Instagram
      </a>
      .
    </Empty>
  </template>
</div>

<style>
  /* :global because the script fills the list, and its elements don't carry Astro's scope attribute */
  .strip :global(.gallery) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Five, three or two columns; once filled, masonry (lib/masonry.ts): each photo its own height, packed */
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
  }
  @media (max-width: 56rem) {
    .strip :global(.gallery) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 36rem) {
    .strip :global(.gallery) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .strip :global(.gallery li) {
    aspect-ratio: 1;
    background: var(--rule);
  }
  .strip :global(.gallery[data-masonry] li) {
    aspect-ratio: auto;
  }
  .strip :global(.gallery li:first-child) {
    grid-column: span 2;
    grid-row: span 2;
  }
  /* Masonry sets its rows (grid-row-end); a span here as well would win, and leave it two 4px rows tall */
  .strip :global(.gallery[data-masonry] li:first-child) {
    grid-row-start: auto;
  }
  .strip :global(.gallery a) {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
  }
  .strip :global(.gallery img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition:
      transform 0.6s var(--ease-out),
      filter 0.4s;
  }
  .strip :global(.gallery a:hover img) {
    transform: scale(1.05);
    filter: none;
  }
</style>

<script>
  import type { StripPhoto } from "../pages/api/photos/latest";
  import { masonry } from "../lib/masonry";

  function item(p: StripPhoto): HTMLLIElement {
    const li = document.createElement("li");
    const a = Object.assign(document.createElement("a"), { href: p.image });
    Object.assign(a.dataset, { photo: "", caption: p.caption ?? "", post: p.href });
    const img = Object.assign(document.createElement("img"), { src: p.image, alt: p.alt, loading: "lazy" });
    // A photo that won't load (gone from Instagram since the list was read) leaves the strip instead of an empty tile
    img.addEventListener("error", () => li.remove(), { once: true });
    a.appendChild(img);
    li.appendChild(a);
    return li;
  }

  async function fill() {
    const strip = document.querySelector<HTMLElement>("[data-photo-strip]");
    const list = strip?.querySelector<HTMLUListElement>("ul[data-gallery]");
    if (!strip || !list) return;
    let photos: StripPhoto[] = [];
    try {
      const res = await fetch("/api/photos/latest", { headers: { Accept: "application/json" } });
      if (res.ok) ({ photos } = (await res.json()) as { photos: StripPhoto[] });
    } catch {
      // offline or blocked: the empty state below
    }
    if (!strip.isConnected) return;
    if (!photos.length) {
      const empty = strip.querySelector<HTMLTemplateElement>("template[data-empty]");
      if (empty) strip.replaceChildren(empty.content.cloneNode(true));
      return;
    }
    list.replaceChildren(...photos.map(item));
    list.removeAttribute("aria-busy");
    // Masonry: each photo its own shape, packed (lib/masonry.ts)
    masonry(list);
  }

  document.addEventListener("astro:page-load", fill);
</script>
