---
// The board, as the team app's (lib/BoardTable): the group games' table, each team's place, crest and name, the
// champions stamped (優勝 for the Kumite, the trophy for any other), then played, won, drawn, lost, goal difference and
// points.
import type { PublishedEdition } from "../../lib/results";
import Icon from "../Icon.astro";
import TeamCrest from "./TeamCrest.astro";
import { kanjiFor } from "./motif";

interface Props {
  r: PublishedEdition;
}
const { r } = Astro.props;
const seal = kanjiFor(r.series, "champions");
const gd = (n: number) => `${n > 0 ? "+" : ""}${n}`;
const heads = [
  ["P", "Played"],
  ["W", "Won"],
  ["D", "Drawn"],
  ["L", "Lost"],
  ["GD", "Goal difference"],
] as const;
---

<table>
  <thead>
    <tr>
      <th class="l" scope="col">
        Team
      </th>
      {heads.map(([h, title]) => (
        <th scope="col">
          <abbr title={title}>{h}</abbr>
        </th>
      ))}
      <th class="pts" scope="col">
        <abbr title="Points">Pts</abbr>
      </th>
    </tr>
  </thead>
  <tbody>
    {r.table.map((t, i) => (
      <tr class:list={{ top: i === 0 && t.p > 0 }}>
        <th class="l" scope="row">
          <span class="team">
            <span class="pos num">{i + 1}</span>
            <TeamCrest team={r.teams.find((x) => x.id === t.teamId)} />
            <span class="name">{t.name}</span>
            {t.teamId === r.championsId && (
              <span class="ink" title="Champions">
                <span class="mark" lang="ja" aria-hidden="true">
                  {seal || <Icon name="trophy" size={12} />}
                </span>
                <span class="word">Champions</span>
              </span>
            )}
          </span>
        </th>
        <td class="num">{t.p}</td>
        <td class="num">{t.w}</td>
        <td class="num">{t.d}</td>
        <td class="num">{t.l}</td>
        <td class="num">{gd(t.gf - t.ga)}</td>
        <td class="num pts">{t.pts}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 1rem 0.75rem;
    color: var(--text-2);
    font-weight: 400;
    text-align: right;
    white-space: nowrap;
  }
  tbody tr + tr > * {
    border-top: 1px solid var(--rule);
  }
  thead th {
    padding-block: 0.75rem 0.5rem;
    color: var(--text-3);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  abbr {
    text-decoration: none;
  }
  /* The team's column takes what the figures leave, and a long name is cut short in it */
  .l {
    width: 100%;
    max-width: 0;
    padding-left: 1rem;
    text-align: left;
  }
  tbody .l {
    color: var(--text);
    font-weight: 500;
  }
  /* Its place, its crest, its name, on one line */
  .team {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .pos {
    flex-shrink: 0;
    width: 1.25rem;
    color: var(--text-3);
  }
  /* The leaders' place in bone: the table's colour is the words */
  .top .pos {
    color: var(--text);
  }
  .name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pts {
    padding-right: 1rem;
    color: var(--text);
    font-weight: 700;
  }
  td.pts {
    font-weight: 400;
  }
  /* The champions' stamp, as the team app's ink stamp: bone, the kanji knocked out of a block of ink, askew */
  .ink {
    display: inline-flex;
    flex: none;
    align-items: stretch;
    border: 1.5px solid var(--text);
    border-radius: 0.45rem 0.25rem 0.5rem 0.3rem / 0.3rem 0.5rem 0.25rem 0.45rem;
    overflow: hidden;
    color: var(--text);
    font-family: var(--display);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    rotate: -3deg;
  }
  .mark {
    display: inline-grid;
    place-items: center;
    padding: 0 0.25rem;
    background: var(--text);
    color: var(--paper);
    font-family: "Kumite Kanji", "Noto Serif JP", serif;
    font-weight: 900;
    letter-spacing: 0;
  }
  .word {
    padding: 0.2rem 0.45rem 0.1rem;
  }
  /* A phone: every column in the width, the figures closer; the stamp's block alone */
  @media (max-width: 600px) {
    th,
    td {
      padding-inline: 0.5rem;
    }
    .l {
      padding-left: 0.75rem;
    }
    .team {
      gap: 0.5rem;
    }
    .word {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
  /* A narrow one: the crests go (the names say it), so the columns fit */
  @media (max-width: 420px) {
    .team :global(.crest) {
      display: none;
    }
  }
</style>
