---
// A touch of the Kumite's motif (motif.ts), as the team app's (lib/Kanji): kanji beside a heading, or a red hanko
// seal. Decoration only, so screen readers skip it. The page sets the face once (motif.ts kanjiFace).
interface Props {
  text: string;
  seal?: boolean;
}
const { text, seal = false } = Astro.props;
---

{text && (
  <span class:list={["kanji", { seal }]} lang="ja" aria-hidden="true">
    {text}
  </span>
)}

<style>
  .kanji {
    margin-left: 0.5rem;
    color: var(--text-3);
    font-family: "Kumite Kanji", "Noto Serif JP", "Hiragino Mincho ProN", "Yu Mincho", serif;
    font-size: 0.85em;
    font-style: normal;
    font-weight: 900;
    letter-spacing: 0.05em;
    vertical-align: 0.05em;
  }
  /* A hanko: the characters stacked in a red square, bone on red, a little askew */
  .seal {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0;
    padding: 0.2rem;
    border-radius: 0.3rem;
    background: var(--red);
    color: var(--text);
    font-size: 1.15rem;
    line-height: 1;
    writing-mode: vertical-rl;
    letter-spacing: 0;
    transform: rotate(-6deg);
    box-shadow: inset 0 0 0 2px rgb(236 232 225 / 0.35);
  }
</style>
