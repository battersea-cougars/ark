---
// The awards, as the team app's (lib/Awards): each award with its line, and who took it home, a team with its crest,
// a player by name, a big tie on one line. Only awards an admin has confirmed (ADR 0044).
import type { PublishedEdition } from "../../lib/results";
import TeamCrest from "./TeamCrest.astro";

interface Props {
  r: PublishedEdition;
}
const { r } = Astro.props;
const awards = r.awards.filter((a) => a.winners.length);
---

<ol class="awards">
  {awards.map((a) => (
    <li class="award">
      <span class="what">
        <span class="award-name">{a.name}</span>
        {a.about && <span class="muted">{a.about}</span>}
      </span>
      <span class="winners">
        {a.winners.length > 2 ? (
          <span class="won-text">
            <span class="won-name">Shared by {a.winners.length}</span>
            <span class="muted shared">{a.winners.map((w) => w.name).join(", ")}</span>
          </span>
        ) : (
          a.winners.map((w) => (
            <span class="won">
              {w.teamId && <TeamCrest team={r.teams.find((t) => t.id === w.teamId)} size="2.25rem" />}
              <span class="won-name">{w.name}</span>
            </span>
          ))
        )}
      </span>
    </li>
  ))}
</ol>

<style>
  .awards {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .award {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
    padding: 0.75rem 0.25rem;
  }
  .award + .award {
    border-top: 1px solid var(--rule);
  }
  .what,
  .won-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .award-name {
    color: var(--text);
    font-weight: 600;
  }
  .winners {
    display: grid;
    flex-shrink: 0;
    justify-items: end;
    gap: 0.5rem;
    max-width: 55%;
    text-align: right;
  }
  .won {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .won-name {
    color: var(--text);
    font-weight: 500;
  }
  .shared {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>
