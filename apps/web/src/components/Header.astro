---
// A ready-sized logo (2x), used as is: server-rendered pages (/photos, ADR 0016) can't resize at build time.
import mark from "../assets/cougars-mark.webp";
import { getClub, getSections } from "../lib/sanity/content";

// One-page navigation: every item is a section of the home page, in page order. From any
// other page the link goes back to that section. Full pages (/fridays/, /team/, ...) are
// reached from the "see all" link inside each section. `time` is the section's slot on the
// Friday-night running order, shown in the menu.
const path = Astro.url.pathname;
const home = path === "/";
// The team and the Kumite only while they're switched on in the Studio (ADR 0109)
const sections = await getSections();
const links = [
  { section: "fridays", label: "Fridays", time: "19:30", page: "/fridays/" },
  { section: "team", label: "The team", time: "21:30", page: "/team/" },
  { section: "kumite", label: "Kumite", time: "--:--", page: "/kumite/" },
  { section: "events", label: "What's on", time: "", page: "/events/" },
  { section: "videos", label: "Videos", time: "", page: "/videos/" },
  { section: "photos", label: "Photos", time: "", page: "/photos/" },
]
  .filter((l) => (l.section === "team" || l.section === "kumite" ? sections[l.section] : true))
  .map((l) => ({ ...l, href: home ? `#${l.section}` : `/#${l.section}` }));
// On a full page, mark the section it belongs to.
const owner = (l: (typeof links)[number]) => l.page !== "" && path.startsWith(l.page);
const current = (l: (typeof links)[number]) => (!home && owner(l) ? "page" : undefined);
const joinCurrent = path.startsWith("/join/") ? "page" : undefined;
const { founded } = await getClub();
---

<header class="header" data-header transition:name="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label="Battersea Cougars, home" data-brand>
      <img src={mark.src} alt="" width="120" height={Math.round((120 * mark.height) / mark.width)} class="brand-mark" />
    </a>
    <!-- Running clock: follows the Friday night down the home page (scripts/motion.ts) -->
    <p class="clock" aria-hidden="true">
      <span class="clock-time" data-clock-time>
        {founded}
      </span>
      <span class="clock-label" data-clock-label>
        Est. Battersea
      </span>
    </p>

    <nav class="nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a class="link" href={l.href} aria-current={current(l)} data-section-link={l.section}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary join" href="/join/" aria-current={joinCurrent}>
        Join
      </a>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <span class="visually-hidden">Menu</span>
      <span class="icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<!-- Outside <header>: its backdrop-filter would otherwise trap this fixed overlay inside the bar. -->
<div class="menu" id="menu" data-menu hidden>
  <p class="menu-head label">Friday night running order</p>
  <ol>
    {links.map((l, i) => (
      <li style={`--i:${i}`}>
        <a href={l.href} aria-current={current(l)}>
          <span class="menu-time">{l.time}</span>
          {l.label}
        </a>
      </li>
    ))}
  </ol>
  <a class="btn btn--primary menu-join" href="/join/" aria-current={joinCurrent} style={`--i:${links.length}`}>
    Try a session
  </a>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 150;
    background: rgb(13 13 15 / 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
    transition:
      background 0.4s ease,
      color 0.4s ease,
      border-color 0.4s ease;
  }
  /* Underground: header goes dark while the Kumite is on screen */
  :global(.header.night) {
    background: rgb(6 6 6 / 0.9);
    border-color: var(--red);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: var(--header-h);
    padding-inline: var(--gutter);
  }
  .brand :global(.brand-mark) {
    width: 4.1rem;
    transition: transform 0.4s var(--ease-smooth);
  }
  .brand:hover :global(.brand-mark) {
    transform: rotate(-5deg) scale(1.06);
  }
  .clock {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule-strong);
    white-space: nowrap;
  }
  /* VCR clock display: red LED digits behind a dark window */
  .clock-time {
    min-width: 5ch;
    padding: 0.15em 0.4em 0.05em;
    border: 1px solid #000;
    border-radius: 2px;
    background: #070707;
    box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.8);
    color: var(--red-hot);
    font-family: var(--osd);
    font-size: 1.45rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-align: center;
    text-shadow:
      0 0 4px var(--red-soft),
      0 0 10px var(--red-soft);
    font-variant-numeric: tabular-nums;
  }
  .clock-label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    font-family: var(--display);
    font-size: 1.08rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .nav ul a:hover,
  .nav ul a[aria-current] {
    color: var(--red-hot);
  }
  .nav .join {
    padding-block: 0.6rem 0.5rem;
  }

  /* Hamburger → X (from ark) */
  .menu-btn {
    display: none;
    position: relative;
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
    color: var(--text);
    cursor: pointer;
  }
  .icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.2rem;
    height: 8px;
    translate: -50% -50%;
  }
  .icon::before,
  .icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition:
      transform 0.35s var(--ease-smooth),
      top 0.35s var(--ease-smooth);
  }
  .icon::after {
    top: 6px;
  }
  [aria-expanded="true"] .icon::before {
    top: 3px;
    transform: rotate(45deg);
  }
  [aria-expanded="true"] .icon::after {
    top: 3px;
    transform: rotate(-45deg);
  }

  /* Mobile menu: the running order, as a sheet of newsprint */
  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 149;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem var(--gutter) 2.5rem;
    overflow-y: auto;
    background: var(--paper);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }
  /* display: flex above would otherwise override [hidden] and leave an invisible overlay on the page */
  .menu[hidden] {
    display: none;
  }
  .menu.is-open {
    opacity: 1;
  }
  .menu ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .menu li a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0 0.55rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--display);
    font-size: clamp(2rem, 9vw, 2.6rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .menu-time {
    min-width: 3.4rem;
    font-size: 0.95rem;
    color: var(--red-hot);
    font-variant-numeric: tabular-nums;
  }
  .menu li a,
  .menu-join {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s var(--ease-smooth) calc(var(--i) * 35ms + 60ms),
      transform 0.35s var(--ease-smooth) calc(var(--i) * 35ms + 60ms);
  }
  .menu.is-open li a,
  .menu.is-open .menu-join {
    opacity: 1;
    transform: none;
  }
  .menu-join {
    align-self: start;
  }
  .menu a[aria-current="page"] {
    color: var(--red-hot);
  }

  @media (max-width: 78rem) {
    .nav ul {
      gap: 1.1rem;
    }
    .nav ul a {
      font-size: 0.98rem;
    }
  }
  @media (max-width: 68rem) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
  @media (max-width: 26rem) {
    .clock-label {
      display: none;
    }
  }
</style>

<script>
  let abort: AbortController | undefined;
  function initMenu() {
    abort?.abort();
    abort = new AbortController();
    const { signal } = abort;
    document.body.style.overflow = "";
    const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
    const menu = document.querySelector<HTMLElement>("[data-menu]");
    if (!btn || !menu) return;
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add("is-open"));
      } else {
        menu.classList.remove("is-open");
        setTimeout(() => (menu.hidden = btn.getAttribute("aria-expanded") === "false"), 300);
      }
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (e) => (e.target as Element).closest("a") && set(false));
    document.addEventListener("keydown", (e) => e.key === "Escape" && set(false), { signal });
    // The logo is a plain link home. Already home, it glides back to the top instead of loading the page again, and
    // the address goes back to "/" (no #section left in it).
    document.querySelector("[data-brand]")?.addEventListener(
      "click",
      (e) => {
        if (location.pathname !== "/") return;
        e.preventDefault();
        const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
        scrollTo({ top: 0, behavior: still ? "auto" : "smooth" });
        if (location.hash) history.replaceState(history.state, "", "/");
      },
      { signal },
    );
  }
  document.addEventListener("astro:page-load", initMenu);
</script>
