---
import { ribbonHead, type Ribbon } from "@cougars/shared/ribbon";

// Which copy of the site this is, in the bottom-right corner (ADR 0010): LOCAL (and below it the checkout's branch) or
// DEV. Base.astro leaves it out in production, so the live site has none of it. Never in the way: taps go through it,
// and it sits clear of the phone's home bar.
interface Props {
  ribbon: Ribbon;
}
const { ribbon } = Astro.props;
---

<div class="env-ribbon" aria-hidden="true" transition:persist="env-ribbon">
  <span>
    <b>{ribbonHead(ribbon)}</b>
    {ribbon.branch && <i>{ribbon.branch}</i>}
  </span>
</div>

<style>
  .env-ribbon {
    /* --box: the corner it clips to; --in: how far in from each edge the band's middle crosses them */
    --box: 8rem;
    --in: 3rem;
    position: fixed;
    right: env(safe-area-inset-right, 0px);
    bottom: env(safe-area-inset-bottom, 0px);
    z-index: 180;
    width: var(--box);
    height: var(--box);
    overflow: hidden;
    pointer-events: none;
  }
  span {
    /* Centred on the corner's diagonal; as wide as the box is across there (2√2 × --in), its ends clipped */
    position: absolute;
    top: 100%;
    left: 100%;
    display: grid;
    gap: 0.15rem;
    box-sizing: border-box;
    width: calc(var(--in) * 2.83);
    padding: 0.25rem 0.6rem;
    transform: translate(calc(-50% - var(--in)), calc(-50% - var(--in))) rotate(-45deg);
    background: var(--yellow);
    color: #0d0d0f;
    text-align: center;
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.35);
  }
  b,
  i {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-style: normal;
  }
  b {
    font:
      700 0.625rem/1 var(--sans),
      sans-serif;
    letter-spacing: 0.14em;
  }
  /* The branch, nearer the corner where the band is shorter */
  i {
    padding-inline: 0.3rem;
    font:
      600 0.6rem/1 var(--sans),
      sans-serif;
    letter-spacing: 0.02em;
  }
  @media (max-width: 720px) {
    .env-ribbon {
      --box: 7rem;
      --in: 2.65rem;
    }
    b {
      letter-spacing: 0.06em;
    }
  }
</style>
