---
import type { Ribbon } from "@cougars/shared/ribbon";

// Which copy of the site this is, in the bottom-right corner (ADR 0010): LOCAL or DEV. Base.astro leaves it out in
// production, so the live site has none of it. Never in the way: taps go through it, and it sits clear of the
// phone's home bar.
interface Props {
  label: Ribbon;
}
const { label } = Astro.props;
---

<div class="env-ribbon" aria-hidden="true" transition:persist="env-ribbon">
  <span>{label}</span>
</div>

<style>
  .env-ribbon {
    position: fixed;
    right: env(safe-area-inset-right, 0px);
    bottom: env(safe-area-inset-bottom, 0px);
    z-index: 180;
    width: 5.5rem;
    height: 5.5rem;
    overflow: hidden;
    pointer-events: none;
  }
  span {
    /* Centred on the corner's diagonal, 2.1rem in from each edge; the box clips the band's ends */
    position: absolute;
    top: 100%;
    left: 100%;
    width: 8rem;
    padding: 0.2rem 0;
    transform: translate(calc(-50% - 2.1rem), calc(-50% - 2.1rem)) rotate(-45deg);
    background: var(--yellow);
    color: #0d0d0f;
    font:
      700 0.625rem/1 var(--sans),
      sans-serif;
    letter-spacing: 0.14em;
    text-align: center;
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.35);
  }
</style>
