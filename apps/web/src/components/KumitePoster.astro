---
// The Kumite, sold like an 80s fight-film release with Bloodsport's underground-tournament
// mystique, and the joke that it is open to anyone: struck-out "invitation only", a redacted
// location that reveals itself on hover, a billing block. The header of /kumite/ (an <h1>); the home page shows its
// teaser (KumiteTeaser), which cuts into it. Kumite is 組手 in Japanese: the kanji run down the side in brush, the club
// is spelt in katakana. Under the title a statement stays ("Only one team walks away.") and a reveal ("Champions.") comes
// out of a blur letter by letter, a red seal (優勝) is stamped beside it, and it dissolves away again, on a loop. The
// tagline, statement and reveal are Studio settings (Kumite).
import { getImage } from "astro:assets";
import background from "../assets/cougars_background.png";
// Only the nine characters the poster uses (Yuji Boku, SIL OFL), so it's a 5 KB file
import brush from "../assets/fonts/YujiBoku-kumite.woff2?url";
import type { ClubEvent } from "../lib/sanity/types";
import { formatDayDate } from "../lib/dates";
import { getSettings } from "../lib/sanity/content";

interface Props {
  next?: ClubEvent;
  href?: string;
  heading?: "h1" | "h2";
}
const { next, href, heading: Heading = "h2" } = Astro.props;
const Tag = href ? "a" : "div";
const bg = (await getImage({ src: background, width: 1600, format: "webp", quality: 70 })).src;
const { kumite } = await getSettings();
// The next Kumite as the team app has it (ADR 0042), else Sanity's event
const upcoming =
  kumite.next ?? (next ? { startsAt: next.startsAt, venue: next.location ?? "", dateTbc: false, season: null } : null);
const dated = upcoming && !upcoming.dateTbc && !upcoming.season;
// The reveal, one span per letter so each can dissolve on its own; a little drift each way, the same every build
const letters = [...kumite.posterReveal].map((ch, i) => ({ ch, dx: `${(((i * 37) % 11) - 5) * 0.05}em` }));
const brushFace = `@font-face{font-family:"Kumite Brush";src:url(${brush}) format("woff2");font-display:block}`;
const credits = [
  ["A", "Battersea Cougars", "production"],
  ["Starring", "whoever signs up", ""],
  ["Teams by", "the draft", ""],
  ["Format", "full round robin", ""],
  ["Survivors", "one team", ""],
  ["Inspired by", "a certain Belgian", "(unofficially)"],
];
---

<style is:inline set:html={brushFace} />
<!-- One poster on both pages (transition:name): pressing it on the home page carries it up into the Kumite page's
     header instead of fading into an identical one (global.css). It reveals on scroll only as the home feature: as
     the page header it has to be there when the transition captures it. -->
<Tag
  class="poster crt"
  href={href}
  style={`--bg:url(${bg})`}
  data-reveal={href ? "" : undefined}
  transition:name="kumite-poster"
>
  <span class="kanji" lang="ja" aria-hidden="true">
    組手
  </span>
  <!-- Rough, painted edge for the title lettering -->
  <svg class="defs" width="0" height="0" aria-hidden="true">
    <filter id="kumite-rough" x="-5%" y="-10%" width="110%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035 0.09" numOctaves="3" seed="7" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="9" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <span class="sticker flag">Special event</span>
  <p class="presents">
    <s>By invitation only</s>
    <span>Open to anyone</span>
  </p>
  <Heading class="title">
    <span class="kana" lang="ja" aria-hidden="true">
      クーガーズ
    </span>
    <span class="the">The Cougars</span>
    <span class="word">Kumite</span>
  </Heading>
  <p class="drama" aria-label={`${kumite.posterStatement} ${kumite.posterReveal}`} data-dissolve>
    <span class="statement" aria-hidden="true">
      {kumite.posterStatement}
    </span>
    <span class="reveal" aria-hidden="true">
      {letters.map(({ ch, dx }, i) => (
        <span class="ch" style={`--i:${i};--dx:${dx}`}>
          {ch === " " ? "\u00a0" : ch}
        </span>
      ))}
      <span class="hanko" lang="ja" style={`--n:${letters.length}`}>
        優勝
      </span>
    </span>
  </p>
  <p class="tagline">{kumite.tagline}</p>

  <div class="date">
    <span class="label">{dated ? "Next fight night" : "Next Kumite"}</span>
    <span class="when" data-countdown={dated ? upcoming.startsAt : undefined}>
      {upcoming?.season ?? (dated ? formatDayDate(upcoming.startsAt) : "Date to be announced")}
    </span>
    {dated && <span class="label togo" data-togo hidden />}
    <span class="where label">
      Location: <span class="redacted">{upcoming?.venue || "Battersea Sports Centre"}</span>
    </span>
  </div>

  <p class="billing">
    {credits.map(([pre, name, post]) => (
      <span>
        <small>{pre}</small> {name} {post && <small>{post}</small>}
      </span>
    ))}
  </p>
  <span class="rating">
    <b>K</b>
    <span>
      Kumite. Helmets, gloves
      <br />
      and shins required.
    </span>
  </span>
  {href && <span class="enter label">Enter the Kumite →</span>}
</Tag>

<style>
  .poster {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    padding: clamp(3rem, 7vw, 5.5rem) var(--gutter) clamp(2rem, 4vw, 3rem);
    overflow: clip;
    text-align: center;
    background:
      radial-gradient(ellipse 70% 60% at 50% 42%, rgb(229 19 31 / 0.32), transparent 70%),
      linear-gradient(to bottom, rgb(11 11 12 / 0.75), rgb(11 11 12 / 0.9)),
      var(--bg) center / cover;
    border-block: 1px solid var(--rule);
  }
  .poster > * {
    position: relative;
    z-index: 2;
    margin: 0;
  }
  .poster .flag {
    position: absolute;
    top: clamp(1.25rem, 3vw, 2.25rem);
    right: clamp(1.25rem, 4vw, 3rem);
    rotate: 5deg;
  }
  .presents {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.2rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .presents s {
    color: var(--text-3);
    text-decoration-color: var(--red-hot);
    text-decoration-thickness: 2px;
  }
  .presents span {
    color: var(--yellow);
  }
  /* Classified, until you look closer */
  .date .where {
    margin-top: 0.6rem;
    color: var(--text-3);
  }
  .redacted {
    position: relative;
    color: var(--text);
  }
  .redacted::after {
    content: "";
    position: absolute;
    inset: -0.15em -0.3em;
    background: #050505;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
    transition: transform 0.45s var(--ease-smooth);
    transform-origin: right center;
  }
  .poster:hover .redacted::after,
  .redacted:hover::after {
    transform: scaleX(0);
  }
  .poster .defs {
    position: absolute;
  }
  .title {
    display: grid;
    justify-items: center;
    line-height: 0.82;
  }
  .the {
    margin-bottom: 0.3em;
    font-size: clamp(1.1rem, 2.6vw, 2rem);
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: var(--text);
  }
  /* Blood-red block capitals with a worn, painted edge, slanted like COUGARS in the logo */
  .word {
    display: inline-block;
    transform: skewX(-10deg);
    font-size: clamp(5.5rem, 24vw, 20rem);
    letter-spacing: -0.005em;
    background: linear-gradient(to bottom, #ff3030 0%, #f0101c 50%, #a80c15 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: url(#kumite-rough) drop-shadow(0 0.03em 0 #3d0306) drop-shadow(0 0 0.25em rgb(229 19 31 / 0.35));
    transition: filter 0.5s var(--ease-smooth);
  }
  a.poster:hover .word {
    filter: url(#kumite-rough) drop-shadow(0 0.03em 0 #3d0306) drop-shadow(0 0 0.4em rgb(229 19 31 / 0.6));
  }
  /* 組手, down the side like a film poster's title in the original. `.poster > .kanji`: as specific as the
     `.poster > *` rule above (Astro scopes every part of a selector), so its own position wins */
  .poster > .kanji {
    position: absolute;
    top: 50%;
    left: clamp(0.5rem, 4vw, 3rem);
    z-index: -1;
    translate: 0 -50%;
    writing-mode: vertical-rl;
    font-family: "Kumite Brush", serif;
    font-size: clamp(5rem, 16vw, 13rem);
    line-height: 1;
    color: rgb(229 19 31 / 0.22);
    pointer-events: none;
  }
  .kana {
    margin-bottom: 0.5em;
    font-family: "Kumite Brush", serif;
    font-size: clamp(0.9rem, 1.8vw, 1.3rem);
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    line-height: 1;
    color: var(--red-hot);
  }
  /* The statement and the reveal: Anton, slanted like the title. The reveal always keeps its space, so nothing moves
     when it comes and goes. */
  .drama {
    display: grid;
    justify-items: center;
    gap: 0.1em;
    margin: 0.4rem 0 0;
    font-family: var(--display);
    font-size: clamp(1.6rem, 4.2vw, 3rem);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .statement,
  .reveal {
    transform: skewX(-10deg);
    white-space: nowrap;
  }
  .statement {
    color: var(--text-2);
  }
  .reveal {
    position: relative;
    color: var(--text);
    font-size: 1.25em;
  }
  /* Each letter comes out of a blur and goes back into one, a beat after the one before */
  .ch {
    display: inline-block;
    transition:
      opacity 0.8s ease,
      filter 0.8s ease,
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 55ms);
  }
  .drama.gone .ch {
    opacity: 0;
    filter: blur(0.25em);
    transform: translate(var(--dx), -0.3em) scale(1.12);
  }
  /* A red seal (優勝, read top to bottom), stamped beside the reveal once its letters have landed */
  .hanko {
    position: absolute;
    top: 50%;
    left: calc(100% + 0.5em);
    display: grid;
    place-items: center;
    width: 1.35em;
    height: 2.5em;
    translate: 0 -50%;
    rotate: 8deg;
    border: 0.07em solid #e5131f;
    border-radius: 0.12em;
    font-family: "Kumite Brush", serif;
    font-size: 0.5em;
    line-height: 1;
    writing-mode: vertical-rl;
    letter-spacing: 0.05em;
    color: #e5131f;
    background: rgb(229 19 31 / 0.08);
    mix-blend-mode: screen;
  }
  .hanko {
    transition:
      opacity 0.12s ease-out calc(var(--n) * 55ms + 0.5s),
      scale 0.22s cubic-bezier(0.2, 1.6, 0.4, 1) calc(var(--n) * 55ms + 0.5s);
  }
  .drama.gone .hanko {
    opacity: 0;
    scale: 1.6;
    transition:
      opacity 0.5s ease,
      scale 0.5s ease;
  }
  .tagline {
    max-width: 34rem;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.5;
    color: var(--text-2);
    text-wrap: balance;
  }
  .date {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
  }
  .date .label {
    font-family: var(--osd);
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    color: var(--yellow);
  }
  .when {
    font-family: var(--display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .date .togo {
    color: var(--text-2);
  }
  /* Film-poster billing block: small words low, names tall and narrow */
  .billing {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem 1.1rem;
    max-width: 46rem;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-family: var(--display);
    font-size: 1.15rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .billing span {
    white-space: nowrap;
  }
  .billing small {
    font-family: var(--sans);
    font-size: 0.48em;
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  .rating {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--text-3);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-align: left;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .rating b {
    display: grid;
    place-items: center;
    padding: 0 0.6rem;
    background: var(--text-3);
    color: var(--paper);
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 400;
  }
  .rating span {
    padding: 0.35rem 0.6rem;
  }
  .enter {
    margin-top: 0.75rem;
    color: var(--text);
    transition: translate 0.35s var(--ease-smooth);
  }
  a.poster:hover .enter {
    translate: 6px 0;
  }
  @media (max-width: 40rem) {
    .poster .flag {
      position: relative;
      top: auto;
      right: auto;
      justify-self: center;
    }
  }
</style>

<script>
  // "23 days to go" under the next Kumite date.
  const update = () => {
    for (const el of document.querySelectorAll<HTMLElement>("[data-countdown]")) {
      const out = el.parentElement?.querySelector<HTMLElement>("[data-togo]");
      const start = Date.parse(el.dataset.countdown ?? "");
      if (!out || Number.isNaN(start)) continue;
      const days = Math.ceil((start - Date.now()) / 86_400_000);
      if (days < 0) continue;
      out.textContent = days === 0 ? "Today" : days === 1 ? "Tomorrow" : `${days} days to go`;
      out.hidden = false;
    }
  };
  document.addEventListener("astro:page-load", update);

  // The reveal (Studio → Kumite): out of a blur, the seal stamped, a hold, then it dissolves away and comes back, for
  // as long as the poster is on screen. Without motion everything just shows (the CSS starts there).
  const SHOWN_MS = 4200;
  const GONE_MS = 1800;

  document.addEventListener("astro:page-load", () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    for (const box of document.querySelectorAll<HTMLElement>("[data-dissolve]")) {
      box.classList.add("gone");
      let timer = 0;
      const show = () => {
        box.classList.remove("gone");
        timer = window.setTimeout(hide, SHOWN_MS);
      };
      const hide = () => {
        box.classList.add("gone");
        timer = window.setTimeout(show, GONE_MS);
      };
      new IntersectionObserver(
        ([e]) => {
          clearTimeout(timer);
          if (e.isIntersecting) timer = window.setTimeout(show, 400);
          else box.classList.add("gone");
        },
        { threshold: 0.4 },
      ).observe(box);
    }
  });
</script>
