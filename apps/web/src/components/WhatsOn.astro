---
// What's on: the next trainings, tournaments (each by its own name) and events, from the club calendar the team app
// keeps (ADR 0042). The home page is prerendered, so it holds a placeholder that its script fills from /whats-on/,
// which renders this same component live. No data-reveal in here: swapped-in elements would never be revealed.
import Empty from "./Empty.astro";
import { formatDayDate, formatShortDay, formatTime, formatWeekday } from "../lib/dates";
import { weeklyRows, type WhatsOnItem } from "../lib/server/whats-on";

interface Props {
  /** Null: not loaded yet (the prerendered page). */
  items: WhatsOnItem[] | null;
  /** The session day, for the empty state. */
  day: string;
}
const { items, day } = Astro.props;
// Each row (unless cancelled) asks about itself: the contact form starts the message with what it's about
// The day big, the times small beneath it; an event running past midnight says when it ends
const times = (i: WhatsOnItem) => {
  if (!i.endsAt) return formatTime(i.startsAt);
  const sameDay = formatDayDate(i.startsAt) === formatDayDate(i.endsAt);
  return `${formatTime(i.startsAt)} to ${sameDay ? "" : `${formatShortDay(i.endsAt)} `}${formatTime(i.endsAt)}`;
};
const about = (i: WhatsOnItem) => (i.dateTbc ? i.title : `${i.title}, ${formatDayDate(i.startsAt)}`);
// The weekly sessions are one row ("Every Fri", next date beneath), naming any week that's called off
const rows = items && weeklyRows(items);
const skipped = (i: WhatsOnItem) =>
  i.weekly?.skipped.length ? `No session ${i.weekly.skipped.map(formatShortDay).join(", ")}` : "";
// The venue opens in a map (its own link, or a search for it: ADR 0030). It sits above the row's own link.
---

<div data-whats-on>
  {items === null ? (
    <p class="loading label" aria-live="polite">
      Checking the calendar… <a href="/events/">All events</a>
    </p>
  ) : rows?.length ? (
    <ul class="whats-on">
      {rows.map((i) => (
        <li
          class:list={[i.kind, { cancelled: i.cancelled, weekly: i.weekly }]}
          data-starts={i.startsAt}
          data-ends={i.endsAt ?? undefined}
        >
          <div class="row">
            <span class="when">
              {i.weekly ? (
                <>
                  <span class="day">Every {formatWeekday(i.startsAt)}</span>
                  <span class="label">
                    Next {formatShortDay(i.startsAt)} · {times(i)}
                  </span>
                </>
              ) : (
                <>
                  <span class="day">{i.season ?? (i.dateTbc ? "Date TBC" : formatShortDay(i.startsAt))}</span>
                  {!i.dateTbc && <span class="label">{times(i)}</span>}
                </>
              )}
            </span>
            <span class="what">
              <span class="title">{i.title}</span>
              {(skipped(i) || i.description) && <span class="about">{skipped(i) || i.description}</span>}
            </span>
            {i.cancelled ? (
              <span class="where label">Cancelled</span>
            ) : i.venue ? (
              <a class="where venue label" href={i.mapUrl ?? undefined} target="_blank" rel="noopener">
                {i.venue}
                <span class="visually-hidden">: map, opens in a new tab</span>
              </a>
            ) : (
              <span />
            )}
            {i.cancelled ? (
              <span />
            ) : (
              <a class="go" href={`/join/?about=${encodeURIComponent(about(i))}`} aria-label={`Ask about ${about(i)}`}>
                →
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <Empty>Nothing on the calendar yet. {day}s never stop.</Empty>
  )}
</div>

<style>
  .whats-on {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  li {
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 15rem 1fr auto 1.5rem;
    align-items: baseline;
    gap: 0.5rem 2rem;
    padding: 1.6rem 0;
    position: relative;
  }
  .when {
    display: grid;
    gap: 0.35rem;
  }
  .day {
    font-family: var(--display);
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .what {
    display: grid;
    gap: 0.35rem;
  }
  .title {
    font-weight: 600;
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .about {
    color: var(--text-2);
  }
  .where {
    text-align: right;
  }
  /* Asking about it is the whole row: the arrow's link stretches over it, and the venue's map link sits on top */
  .go {
    justify-self: end;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.3s var(--ease-smooth);
  }
  .go::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .go:focus-visible {
    outline: none;
  }
  .row:has(.go:focus-visible) {
    outline: 2px solid var(--red);
    outline-offset: 4px;
  }
  .row:hover:not(:has(.venue:hover)) .go,
  .go:focus-visible {
    color: var(--red);
  }
  .venue {
    position: relative;
    z-index: 1;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--text-3);
    text-underline-offset: 0.3em;
    transition:
      color 0.3s var(--ease-smooth),
      text-decoration-color 0.3s var(--ease-smooth);
  }
  .venue:hover,
  .venue:focus-visible {
    color: var(--red);
    text-decoration-color: currentColor;
  }
  .tournament .title {
    color: var(--red);
  }
  .cancelled .title {
    text-decoration: line-through;
    color: var(--text-3);
  }
  .cancelled .where {
    color: var(--red);
  }
  .loading {
    min-height: 6rem;
    margin: 0;
    padding: 1.6rem 0;
    border-top: 1px solid var(--rule);
  }
  @media (max-width: 44rem) {
    .row {
      grid-template-columns: 1fr 1.5rem;
    }
    .when,
    .what,
    .where {
      grid-column: 1;
      text-align: left;
    }
    .go {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: center;
    }
  }
</style>

<script>
  // Fill in the live list. If it fails (offline, blocked), the placeholder's link to all events stays.
  async function refresh() {
    // Only the home page's placeholder: the events page renders its own, longer list live
    const box = document.querySelector<HTMLElement>("[data-whats-on]");
    if (!box?.querySelector(".loading")) return;
    try {
      const res = await fetch("/whats-on/", { headers: { Accept: "text/html" } });
      if (!res.ok) return;
      const fresh = new DOMParser().parseFromString(await res.text(), "text/html").querySelector("[data-whats-on]");
      if (fresh && box.isConnected) box.replaceChildren(...fresh.childNodes);
    } catch {
      // keep the placeholder
    }
  }

  document.addEventListener("astro:page-load", refresh);
</script>
