---
import { getSettings, getSponsors } from "../lib/sanity/content";
import { imageUrl } from "../lib/sanity/images";
import Icon, { type IconName } from "./Icon.astro";

const s = await getSettings();
const sponsors = await getSponsors();
const slot = s.training[0];
const day = slot?.day ?? "Friday";
const socials = [
  { href: s.socials.instagram, label: "Instagram", icon: "instagram" },
  { href: s.socials.facebook, label: "Facebook", icon: "facebook" },
  { href: s.socials.youtube, label: "YouTube", icon: "youtube" },
].filter((x): x is { href: string; label: string; icon: IconName } => Boolean(x.href));
// No "Fancy it? Try a session" on the Try a session page and its thanks page: they're already there
const call = !Astro.url.pathname.startsWith("/join/");
---

<footer class="footer">
  <!-- Last call: the invitation, one red button -->
  {call && (
    <div class="call">
      <div class="wrap call-inner">
        <p class="call-line">Fancy it?</p>
        <p class="call-sub">
          Come down on a {day}.{s.firstSessionKit && " First session, there's spare kit to borrow."} Splits optional.
          After that, you're one of us.
        </p>
        <a class="btn btn--primary call-btn" href="/join/">
          Try a session
        </a>
      </div>
    </div>
  )}

  <div class="wrap base">
    {sponsors.length > 0 && (
      <ul class="sponsors">
        {sponsors.map((sp) => (
          <li>
            <a href={sp.url ?? undefined} rel="noopener" target="_blank">
              {sp.logo ? <img src={imageUrl(sp.logo, 240)} alt={sp.name} loading="lazy" /> : sp.name}
            </a>
          </li>
        ))}
      </ul>
    )}
    <div class="cols">
      <p class="brand">
        <a href="/">
          Battersea
          <br />
          Cougars
        </a>
      </p>
      <div>
        <p class="label">Rink</p>
        {slot && (
          <p>
            {slot.day}s {slot.start}–{slot.end}
          </p>
        )}
        <p>
          <a class="link with-icon" href={s.venue.mapUrl} rel="noopener" target="_blank">
            <Icon name="pin" />
            {s.venue.name}
          </a>
        </p>
      </div>
      <div>
        <p class="label">Afterwards</p>
        <p>
          {s.pub.mapUrl ? (
            <a class="link with-icon" href={s.pub.mapUrl} rel="noopener" target="_blank">
              <Icon name="pin" />
              {s.pub.name}
            </a>
          ) : (
            s.pub.name
          )}
        </p>
      </div>
      <div>
        <p class="label">Say hello</p>
        {s.contactEmail && (
          <p>
            <a class="link with-icon email" href={`mailto:${s.contactEmail}`}>
              <Icon name="mail" />
              {s.contactEmail}
            </a>
          </p>
        )}
        <p class="social">
          {socials.map((x) => (
            <a class="link with-icon" href={x.href} rel="noopener" target="_blank">
              <Icon name={x.icon} />
              {x.label}
            </a>
          ))}
        </p>
      </div>
    </div>
    <p class="legal label">
      © {new Date().getFullYear()} Battersea Cougars Inline Hockey Club · Est. {s.founded} · South West London ·{" "}
      <a class="link" href="/privacy/">
        Privacy
      </a>
    </p>
  </div>
</footer>

<style>
  .call {
    border-top: 1px solid var(--rule);
  }
  .call-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 1rem 3rem;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .call-line {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .call-sub {
    max-width: 34rem;
    margin: 0;
    color: var(--text-2);
    line-height: 1.5;
  }
  .base {
    border-top: 1px solid var(--rule);
    padding-block: 3.5rem 2rem;
    font-size: 0.92rem;
    color: var(--text-2);
  }
  .cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 2rem;
  }
  .cols p {
    margin: 0 0 0.35rem;
  }
  .cols .label {
    margin-bottom: 0.6rem;
  }
  .brand {
    font-family: var(--display);
    font-size: 2rem;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--text);
  }
  .brand a {
    color: inherit;
    transition: color 0.2s;
  }
  .brand a:hover {
    color: var(--red-hot);
  }
  .with-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  /* A long address breaks rather than pushing the page wider than a phone */
  .email {
    overflow-wrap: anywhere;
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .legal {
    margin: 3rem 0 0;
  }
  .sponsors {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem;
  }
  .sponsors img {
    max-height: 2.25rem;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
  }
  @media (max-width: 52rem) {
    .call-inner {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 30rem) {
    .cols {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
