{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs", "eslint.config.js"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/team": {
      "entry": ["worker/index.ts", "src/main.ts", "public/sw.js", "native/sync.mjs", "journeys/*.{ts,mjs}"],
      "project": ["{src,worker,journeys,native}/**/*.{ts,svelte,mjs}"]
    },
    "apps/studio": {
      "entry": ["seed.ts", "migrate-settings.ts"]
    },
    "apps/web": {},
    "packages/shared": {
      "entry": ["testing/setup.ts"]
    }
  }
}
